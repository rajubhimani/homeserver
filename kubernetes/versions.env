# Pinned versions of every cluster component (one place to update).
# Read by bootstrap.py and the docker-to-kubernetes guide (docs/17).
#
# Rules (docs/10-new-services.md):
# - None of these projects publishes an LTS line, so each is its newest
#   community-supported stable release ("LTS, always" fallback).
# - Kubernetes itself follows managed-cloud parity: the newest minor that
#   EKS, AKS and GKE's stable channel all support (checked 2026-10-03:
#   EKS up to 1.36, AKS 1.35-1.37, GKE stable defaults to 1.35), so a
#   cluster built here moves to any of them.
# Checked 2026-10-03 against each project's GitHub releases.

# Kubernetes / kind
KIND_VERSION=v0.33.0
KUBERNETES_VERSION=v1.35.8
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0

# Routing: Gateway API (ingress-nginx was retired March 2026) via Traefik
GATEWAY_API_VERSION=v1.6.2
TRAEFIK_CHART_VERSION=41.6.1
METALLB_CHART_VERSION=0.16.1

# Databases (operators)
CNPG_VERSION=1.30.1
# The cloudnative-pg Helm chart that installs exactly CNPG_VERSION (its appVersion)
CNPG_CHART_VERSION=0.29.1
BARMAN_CLOUD_PLUGIN_VERSION=0.15.1
# The plugin-barman-cloud Helm chart that installs exactly BARMAN_CLOUD_PLUGIN_VERSION (its appVersion)
BARMAN_CLOUD_PLUGIN_CHART_VERSION=0.8.1
# cert-manager: required by the Barman Cloud plugin (its install docs); newest minor
CERT_MANAGER_CHART_VERSION=v1.21.2
MARIADB_OPERATOR_VERSION=26.10.1

# GitOps, ops UI, backups
# Secrets: External Secrets Operator (docs/17 "Secrets"); Reloader restarts pods on a changed Secret
EXTERNAL_SECRETS_CHART_VERSION=2.11.0
RELOADER_CHART_VERSION=2.2.18
ARGOCD_VERSION=v3.5.3
HEADLAMP_VERSION=v0.45.0
HEADLAMP_CHART_VERSION=0.45.0
VELERO_VERSION=v1.18.4
# The vmware-tanzu Velero chart (ships 1.18.2; the image is pinned to VELERO_VERSION) and its S3 plugin
VELERO_CHART_VERSION=12.2.0
VELERO_AWS_PLUGIN_VERSION=v1.14.4
# MinIO's client for the backup store's setup and the dump jobs (the maintained fork, as Compose's AppFlowy)
MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z
# Backup object store: the maintained MinIO fork Compose already runs
# (upstream minio/minio stopped releasing in Oct 2025).
MINIO_IMAGE=pgsty/minio:RELEASE.2026-09-16T00-00-00Z
LOCAL_PATH_PROVISIONER_VERSION=v0.0.37

# Client tools (install steps: docs/17-docker-to-kubernetes.md)
HELM_VERSION=v4.3.0
# kubectl works one minor either side of the cluster; pinned to the cluster's own minor.
KUBECTL_VERSION=v1.35.9

# Images the generator adds around app containers
# git-sync (kubernetes/git-sync): clones repo content (e.g. docs) into pods.
GIT_SYNC_IMAGE=registry.k8s.io/git-sync/git-sync:v4.7.1
# Startup-order waits (depends_on -> initContainer): the same alpine Compose
# already uses for its *-permissions jobs; its busybox nc polls the port.
WAIT_IMAGE=alpine:3.24.2

# Database images used by the operators. CNPG needs its own operand images:
# PostgreSQL 18.6 (same version as Compose's postgres:18.6-alpine), "standard"
# flavour (common extensions such as pgvector), timestamped tag = immutable.
CNPG_POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6-202608131513-standard-trixie
