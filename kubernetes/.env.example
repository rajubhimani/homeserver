# kubernetes/.env — copy to kubernetes/.env (gitignored, same convention as
# every other service's .env in this repo) and fill in real values, then run
# ./kubernetes/apply-secrets.sh to create/update the matching k8s Secrets.

# ArgoCD admin login (https://localhost:8081 while port-forwarded). Plaintext
# here, but apply-secrets.sh bcrypt-hashes it before it ever reaches the
# cluster — ArgoCD only accepts a bcrypt hash in its Secret, never plaintext.
ARGOCD_ADMIN_PASSWORD=your_admin_password_here

# Shared Postgres (postgres-shared StatefulSet, namespace: data) superuser
# password (generate with: openssl rand -hex 16)
POSTGRES_SHARED_PASSWORD=your_postgres_password_here

# Shared MariaDB (mariadb-shared StatefulSet, namespace: data) root password
# (generate with: openssl rand -hex 16)
MARIADB_SHARED_ROOT_PASSWORD=your_mariadb_root_password_here

# Guacamole's own dedicated Postgres (not the shared server — needs its own
# schema bootstrapped fresh, see apps/guacamole/postgres-init-configmap.yaml)
GUACAMOLE_DB_PASSWORD=your_guacamole_db_password_here

# Vaultwarden admin panel token (generate with: openssl rand -base64 48)
VAULTWARDEN_ADMIN_TOKEN=your_vaultwarden_admin_token_here

# Forgejo's own dedicated Postgres (not the shared server)
FORGEJO_DB_PASSWORD=your_forgejo_db_password_here

# Firefly's own dedicated Postgres (not the shared server)
FIREFLY_DB_PASSWORD=your_firefly_db_password_here
# Must be exactly 32 characters (generate: openssl rand -base64 24 | tr -d '=+/' | cut -c1-32)
FIREFLY_APP_KEY=your_32_character_app_key_here_
# Generate with: openssl rand -hex 16
FIREFLY_CRON_TOKEN=your_firefly_cron_token_here

# Nextcloud's own dedicated Postgres + admin account (no $ in the password —
# same reason as the compose stack's own .env.example: Compose mangles $VAR
# patterns, not relevant here, but keeping the convention consistent)
NEXTCLOUD_DB_PASSWORD=your_nextcloud_db_password_here
NEXTCLOUD_ADMIN_PASSWORD=your_nextcloud_admin_password_here

# Immich's own dedicated Postgres (vendor pgvector/vectorchord image) +
# app secret (generate with: openssl rand -hex 32)
IMMICH_DB_PASSWORD=your_immich_db_password_here
IMMICH_SECRET=your_immich_secret_here

# SilverBullet basic-auth login (format: username:password)
SILVERBULLET_SB_USER=admin:your_strong_password_here

# OpenProject secret key (generate with: openssl rand -hex 64)
OPENPROJECT_SECRET_KEY_BASE=your_secret_key_here

# Mealie's own dedicated Postgres
MEALIE_DB_PASSWORD=your_mealie_db_password_here

# Miniflux's own dedicated Postgres + admin account
MINIFLUX_DB_PASSWORD=your_miniflux_db_password_here
MINIFLUX_ADMIN_PASSWORD=your_miniflux_admin_password_here

# Vikunja's own dedicated Postgres
VIKUNJA_DB_PASSWORD=your_vikunja_db_password_here

# BookStack's own dedicated MariaDB + Laravel app key (generate: openssl rand -base64 32, prefix with "base64:")
BOOKSTACK_DB_ROOT_PASSWORD=your_bookstack_db_root_password_here
BOOKSTACK_DB_PASSWORD=your_bookstack_db_password_here
BOOKSTACK_APP_KEY=base64:your_generated_app_key_here

# Outline's own dedicated Postgres + core secrets (generate with: openssl rand -hex 32)
OUTLINE_DB_PASSWORD=your_outline_db_password_here
OUTLINE_SECRET_KEY=your_random_64_char_hex_secret
OUTLINE_UTILS_SECRET=your_random_64_char_hex_secret

# Wallabag's own dedicated Postgres + Symfony secret
WALLABAG_DB_PASSWORD=your_wallabag_db_password_here
WALLABAG_SECRET=your_random_secret_here

# Atuin's own dedicated Postgres
ATUIN_DB_PASSWORD=your_atuin_db_password_here

# NocoDB's own dedicated Postgres + JWT signing secret (generate: openssl rand -hex 24)
NOCODB_DB_PASSWORD=your_nocodb_db_password_here
NOCODB_JWT_SECRET=your_random_secret_here

# Listmonk's own dedicated Postgres + admin bootstrap account
LISTMONK_DB_PASSWORD=your_listmonk_db_password_here
LISTMONK_ADMIN_PASSWORD=your_listmonk_admin_password_here

# Documenso's own dedicated Postgres + app secrets (generate: openssl rand -base64 32)
DOCUMENSO_DB_PASSWORD=your_documenso_db_password_here
DOCUMENSO_NEXTAUTH_SECRET=your_random_secret_here
DOCUMENSO_ENCRYPTION_KEY=your_random_32char_key_here
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=your_random_32char_key_here
# documenso-cert Secret is NOT built from .env — apply-secrets.sh generates a
# throwaway self-signed cert.p12 on the fly (test pilot only, no real SMTP/
# signing use here) and creates the Secret directly from the file.

# InvoiceShelf's own dedicated MariaDB + Laravel app key (generate: echo "base64:$(openssl rand -base64 32)")
INVOICESHELF_DB_PASSWORD=your_invoiceshelf_db_password_here
INVOICESHELF_DB_ROOT_PASSWORD=your_invoiceshelf_db_root_password_here
INVOICESHELF_APP_KEY=base64:your_generated_app_key_here

# OrangeHRM's own dedicated MariaDB (app itself has no DB env vars — wired
# via its web installer instead, see compose.yml's comment)
ORANGEHRM_DB_PASSWORD=your_orangehrm_db_password_here
ORANGEHRM_DB_ROOT_PASSWORD=your_orangehrm_db_root_password_here

# Cal.com's own dedicated Postgres + app secrets (NEVER change
# CALCOM_ENCRYPTION_KEY after first run — corrupts stored integration credentials)
CALCOM_DB_PASSWORD=your_calcom_db_password_here
CALCOM_NEXTAUTH_SECRET=your_random_secret_here
CALCOM_ENCRYPTION_KEY=your_random_encryption_key_here

# Plausible's own dedicated Postgres + ClickHouse + app secrets
# TOTP_VAULT_KEY must be the literal base64 output of `openssl rand -base64 32`
# (a same-length hex string decodes to only 16 bytes and Plausible refuses to boot)
PLAUSIBLE_DB_PASSWORD=your_plausible_db_password_here
PLAUSIBLE_CLICKHOUSE_PASSWORD=your_plausible_clickhouse_password_here
PLAUSIBLE_SECRET_KEY_BASE=your_random_secret_here
PLAUSIBLE_TOTP_VAULT_KEY=your_random_totp_key_here

# n8n's own dedicated Postgres + credential encryption key (generate: openssl rand -hex 32)
# NEVER change/lose this after first run — every stored credential becomes unreadable
N8N_DB_PASSWORD=your_n8n_db_password_here
N8N_ENCRYPTION_KEY=your_random_64_char_hex_secret_here

# Stirling-PDF Lite admin login
STIRLING_PDF_LITE_ADMIN_PASSWORD=your_stirling_pdf_lite_admin_password_here

# Open WebUI session secret (generate: openssl rand -hex 32)
OPEN_WEBUI_SECRET_KEY=your_open_webui_secret_key_here

# Beszel agent pairing — leave blank for the first start, same as the
# compose stack's beszel/.env.example (fill in after first hub login)
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=

# Cloudflare Tunnel token — same tunnel as the compose stack's
# cloudflared/.env, reused here (one tunnel, either orchestrator can run it,
# never both at once)
TUNNEL_TOKEN=your_tunnel_token_here

# Paperless-ngx's own dedicated Postgres + app secrets
PAPERLESS_DB_PASSWORD=your_paperless_db_password_here
# Generate with: openssl rand -hex 32
PAPERLESS_SECRET_KEY=your_paperless_secret_key_here
PAPERLESS_ADMIN_PASSWORD=your_paperless_admin_password_here

# Authentik's own dedicated Postgres + secret key (generate: openssl rand -base64 60)
AUTHENTIK_DB_PASSWORD=your_authentik_db_password_here
AUTHENTIK_SECRET_KEY=your_authentik_secret_key_here

# AppFlowy's own dedicated Postgres + MinIO + JWT secret (generate JWT: openssl rand -hex 32)
APPFLOWY_DB_PASSWORD=your_appflowy_db_password_here
APPFLOWY_MINIO_ROOT_USER=appflowy-minio
APPFLOWY_MINIO_ROOT_PASSWORD=your_appflowy_minio_password_here
APPFLOWY_JWT_SECRET=your_appflowy_jwt_secret_here

# Plane's own dedicated Postgres + RabbitMQ + MinIO + secret key (generate: openssl rand -hex 32)
PLANE_DB_PASSWORD=your_plane_db_password_here
PLANE_RABBITMQ_PASSWORD=your_plane_rabbitmq_password_here
PLANE_MINIO_ROOT_USER=plane-minio
PLANE_MINIO_ROOT_PASSWORD=your_plane_minio_password_here
PLANE_SECRET_KEY=your_plane_secret_key_here

# Karakeep's Meilisearch master key + NextAuth secret (generate: long random strings)
KARAKEEP_MEILI_MASTER_KEY=your_karakeep_meili_key_here
KARAKEEP_NEXTAUTH_SECRET=your_karakeep_nextauth_secret_here

# Penpot's own dedicated Postgres + master secret key
# (generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
PENPOT_DB_PASSWORD=your_penpot_db_password_here
PENPOT_SECRET_KEY=your_penpot_secret_key_here

# Observability's Grafana admin login
OBSERVABILITY_GRAFANA_ADMIN_USER=admin
OBSERVABILITY_GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here

# Supabase — one Postgres superuser password shared by every role
# roles.sql creates (see supabase/volumes/db/roles.sql), plus every app
# secret. Same generation recipe as the compose stack's supabase/.env.example
# (bash supabase/generate-keys.sh, or by hand — see that file's comments).
SUPABASE_POSTGRES_PASSWORD=your_supabase_postgres_password_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DASHBOARD_USERNAME=supabase
SUPABASE_DASHBOARD_PASSWORD=your_supabase_dashboard_password_here
SUPABASE_SECRET_KEY_BASE=your_supabase_secret_key_base_here
SUPABASE_REALTIME_DB_ENC_KEY=your_16_char_key
SUPABASE_VAULT_ENC_KEY=your_32_char_key
SUPABASE_PG_META_CRYPTO_KEY=your_supabase_pg_meta_crypto_key_here
SUPABASE_S3_PROTOCOL_ACCESS_KEY_ID=your_supabase_s3_access_key_id_here
SUPABASE_S3_PROTOCOL_ACCESS_KEY_SECRET=your_supabase_s3_access_key_secret_here
SUPABASE_POOLER_TENANT_ID=your_supabase_pooler_tenant_id_here
# Opaque API keys / asymmetric JWKs — left blank (legacy HS256 keys above are
# used instead), same as the compose stack's supabase/.env.example
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY_ASYMMETRIC=
SUPABASE_SERVICE_ROLE_KEY_ASYMMETRIC=
SUPABASE_OPENAI_API_KEY=

# PhotoPrism's own dedicated MariaDB + admin account
PHOTOPRISM_DB_ROOT_PASSWORD=your_photoprism_db_root_password_here
PHOTOPRISM_DB_PASSWORD=your_photoprism_db_password_here
PHOTOPRISM_ADMIN_PASSWORD=your_photoprism_admin_password_here

# GitLab CE — no secrets needed here. Omnibus bundles its own Postgres/Redis
# and generates the initial root password itself on first boot (same as the
# compose stack — see kubernetes/TROUBLESHOOTING.md or `kubectl exec` in and
# read /etc/gitlab/initial_root_password if you ever need it).

# Stirling-PDF (full) — no secrets needed here. SECURITY_ENABLELOGIN stays
# false, same default as the compose stack's stirling-pdf/.env.example, so
# there's no admin login to provision.
