# Test cluster on this machine (kind). Host-specific, so copy to kubernetes/.env
# and adjust. Not secret; service secrets come from services/<svc>/.env.
# Guide: docs/17-docker-to-kubernetes.md.

K8S_CLUSTER_NAME=homeserver-test

# Where Traefik (the cluster's router) listens on this host, loopback only.
# Kept off 80/443 and Docker's ports so kind runs next to the Compose stack.
K8S_HTTP_PORT=18080
K8S_HTTPS_PORT=18443

# Storage, mirroring the host disk layout (databases on the SSD):
#   fast -> databases, Valkey, small app config (SSD)
#   bulk -> larger app data, logs (SSD)
#   backup -> the backup store (HDD: a backup must not share a disk with its data)
K8S_FAST_PATH=/home/youruser/k8s-data/fast
K8S_BULK_PATH=/home/youruser/k8s-data/bulk
K8S_BACKUP_PATH=/mnt/mydata/k8s-data/backup

# kind stores every image a second time inside its node container. Point the
# node's image store at a roomy disk so those copies don't fill the SSD.
K8S_IMAGES_PATH=/home/youruser/k8s-data/containerd

# Backup store keys (docs/17 "Backups"): the cluster's MinIO root login, then
# one S3 key per bucket (postgres, velero, dumps), each limited to its own
# bucket. Generated by cluster.py secrets on first use; for an outside S3
# store (kubernetes/deploy/<env>.yaml backup.endpoint), put its keys here.
# BACKUP_STORE_ROOT_USER=     BACKUP_STORE_ROOT_PASSWORD=
# BACKUP_VELERO_REPO_PASSWORD=   (encrypts Velero's volume backups; never change it after the first backup)
# BACKUP_POSTGRES_ACCESS_KEY= BACKUP_POSTGRES_SECRET_KEY=
# BACKUP_VELERO_ACCESS_KEY=   BACKUP_VELERO_SECRET_KEY=
# BACKUP_DUMPS_ACCESS_KEY=    BACKUP_DUMPS_SECRET_KEY=

# Where cluster.py export writes the cluster's data (database dumps, volume
# tars) for import --from-export, e.g. into a rebuilt cluster. HDD.
K8S_EXPORT_PATH=/mnt/mydata/k8s-data/export

# Where cluster.py create writes the API server's encryption config for
# Secrets (owner-only). The key itself is K8S_SECRETS_ENCRYPTION_KEY below,
# generated on the first create; don't share or commit it.
K8S_ENCRYPTION_DIR=/home/youruser/k8s-data/encryption
# K8S_SECRETS_ENCRYPTION_KEY=   (generated by cluster.py create)

# Which environment k8s.py edits by default (kubernetes/deploy/<env>.yaml):
# test (*.k8s.local, only on this machine) or prod (the real DOMAIN; only
# with the Cloudflare tunnel on the cluster)
K8S_ENV=test
