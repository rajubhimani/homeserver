# Jellyfin — Storage paths
DATA_ROOT=../service_data/data/jellyfin

# Path to your media (movies, TV shows, music)
MEDIA_ROOT=/mnt/seagate/media

# Tuning applied by apply-tuning.py — see docs/services/jellyfin.md for why
# each of these values. All have defaults baked into the script if unset here.

# Scan/trickplay concurrency — leave unset to default to the host's CPU core
# count. Only raise this if MEDIA_ROOT is local/direct-attached storage; high
# concurrency is hard on network shares (SMB/NFS).
# JELLYFIN_SCAN_CONCURRENCY=8

# SQLite locking mode (NoLock/Optimistic/Pessimistic) — fixes "database is
# locked" errors during large scans. Optimistic is the recommended first step.
# JELLYFIN_LOCKING_BEHAVIOR=Optimistic

# Embedded-image-extraction timeout in ms — Jellyfin's ~10s default is tight
# for CPU-decoded HEVC/10-bit content, especially under scan concurrency.
# JELLYFIN_IMAGE_EXTRACTION_TIMEOUT_MS=30000

# Trickplay thumbnail generation process priority
# (Idle/BelowNormal/Normal/AboveNormal/High/RealTime — full .NET ProcessPriorityClass set)
# JELLYFIN_TRICKPLAY_PROCESS_PRIORITY=Normal
