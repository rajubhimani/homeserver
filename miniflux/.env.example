# Miniflux — Storage paths
DATA_ROOT=../service_data/data/miniflux

# Postgres
POSTGRES_DB=miniflux
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=your_strong_password

# Admin account (created on first start)
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=your_strong_password

# Remaining Miniflux env vars (image defaults — not previously set, no behavior change)
LOG_LEVEL=info
LOG_FORMAT=text
POLLING_FREQUENCY=60
POLLING_PARSING_ERROR_LIMIT=3
BATCH_SIZE=100
WORKER_POOL_SIZE=16
CLEANUP_FREQUENCY_HOURS=24
CLEANUP_ARCHIVE_READ_DAYS=60
CLEANUP_ARCHIVE_UNREAD_DAYS=180
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=1
HTTP_CLIENT_TIMEOUT=20
