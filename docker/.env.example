# docker/.env — copy to docker/.env (gitignored, same convention — and
# same filename — as every service's .env in this repo) and adjust. One config
# surface regardless of OS — docker-limits.py detects the platform it's
# actually running on (Fedora/btrfs, Ubuntu/ext4, or Windows/Docker Desktop)
# and picks the right underlying mechanism. See docker/README.md for what
# each platform actually does with these values.

# CPU cores Docker (daemon + every container combined) may use.
# Leave unset to default to half this host's CPU count.
DOCKER_CPU_CORES=8

# Memory ceiling for Docker (daemon + every container combined).
DOCKER_MEMORY_LIMIT=10G

# Soft ceiling — reclaim/throttle starts here instead of waiting for the
# hard OOM-kill at DOCKER_MEMORY_LIMIT. Leave unset to auto-compute as 90%
# of DOCKER_MEMORY_LIMIT.
DOCKER_MEMORY_HIGH=

# Disk ceiling for Docker's data-root (images/containers/volumes combined).
DOCKER_DISK_LIMIT=50G

# Per-container log rotation — caps runaway stdout/stderr from silently
# filling disk (the single most common cause of a "Docker filled the disk"
# incident that has nothing to do with images/volumes at all).
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
