# Injected automatically by homeserver.py as an absolute path — this value
# is only a fallback for running `docker compose` directly.
DATA_ROOT=../service_data/data/observability

# Dev/prod host ports (see docs/11-services-reference.md before changing)
GRAFANA_PORT=8134
PROMETHEUS_PORT=8135

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# How long metrics/logs are kept before being deleted — bounds backup size
# since this data isn't regenerable. Prometheus format: 15d, 336h, etc.
# Loki format must be in hours (336h = 14d).
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=336h
