# Nextcloud — Storage paths
DATA_ROOT=../service_data/nextcloud
USER_DATA_ROOT=/mnt/seagate

# Postgres
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=your_strong_password

# Nextcloud admin account
# IMPORTANT: password must not contain $ (dollar sign) — Docker Compose will
# treat $VAR patterns as variable references and mangle the value. Use hex or
# alphanumeric passwords only (e.g. openssl rand -hex 20)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=your_strong_password_no_dollar_signs

