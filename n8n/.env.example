# n8n — Storage paths
DATA_ROOT=../service_data/data/n8n

# Postgres
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_strong_password

# Encrypts stored credentials — generate with: openssl rand -hex 32
# Set this before first start and never change/lose it, or every stored
# credential becomes unreadable.
N8N_ENCRYPTION_KEY=your_random_64_char_hex_secret

# No public self-registration — the first account becomes the instance owner,
# who then invites additional users from inside the app. No env var toggle
# applies here.

# Remaining n8n env vars (image defaults — not previously set, no behavior change)
GENERIC_TIMEZONE=UTC
N8N_METRICS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
