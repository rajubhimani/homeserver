# ── Global homeserver configuration ──────────────────────────────────────────
# Set your domain here — homeserver.py injects it into all services that need it.
DOMAIN=yourdomain.com

# ── Container runtime ────────────────────────────────────────────────────────
# Uncomment ONE group below. Comment out the other.

# ── Docker (default) ──
RUNTIME=docker
DOCKER_SOCKET=/var/run/docker.sock

# ── Podman (rootful) ──
# RUNTIME=podman
# DOCKER_SOCKET=/run/podman/podman.sock

# ── Podman (rootless — replace 1000 with your UID) ──
# RUNTIME=podman
# DOCKER_SOCKET=/run/user/1000/podman/podman.sock

# ── Backups ───────────────────────────────────────────────────────────────────
# 'down' automatically snapshots a service's named volumes + data dir into
# service_data/backup/<service>/<timestamp>/ every time it stops (pass
# --no-backup to skip). This many snapshots are kept per service before the
# oldest are auto-pruned. -1 = never prune (unlimited history).
BACKUP_RETENTION=5

# ── Docker backend ────────────────────────────────────────────────────────────
# 'subprocess' (default) needs no extra dependencies — calls docker/docker
# compose directly and parses their text output.
# 'python-on-whales' gives typed exceptions/structured errors instead of
# parsed CLI text for compose operations — same underlying docker CLI calls,
# clearer failure messages. Install first: uv sync --extra docker-sdk
# DOCKER_BACKEND=python-on-whales
