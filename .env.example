# ── Global homeserver configuration ──────────────────────────────────────────
# Set your domain here — homeserver.py injects it into all services that need it.
DOMAIN=yourdomain.com

# The shared 'homeserver' Docker network's subnet. homeserver.py creates the network with exactly this subnet and
# derives the Browser Hub's fixed IPs from it (x.y.255.240-250), so the two can never disagree. Pick a /16 that no
# other Docker network on this host uses (`docker network ls`; Docker hands out 172.17-172.31 in order).
# Changing it on a running host means recreating the network (down all, `docker network rm homeserver`, up).
HOMESERVER_SUBNET=172.19.0.0/16

# ── Container runtime ────────────────────────────────────────────────────────
# Uncomment ONE group below. Comment out the other.

# ── Docker (default) ──
RUNTIME=docker
DOCKER_SOCKET=/var/run/docker.sock

# ── Podman (rootful) ──
# RUNTIME=podman
# DOCKER_SOCKET=/run/podman/podman.sock

# ── Podman (rootless — replace 1000 with your UID) ──
# RUNTIME=podman
# DOCKER_SOCKET=/run/user/1000/podman/podman.sock

# ── Backups ───────────────────────────────────────────────────────────────────
# 'down' automatically snapshots a *running* service's named volumes + data
# dir into service_data/backup/<service>/<timestamp>/ as it stops (pass
# --no-backup to skip; an already-stopped service isn't re-snapshotted, its
# last snapshot is still current). This many snapshots are kept per service
# before the oldest are auto-pruned. -1 = never prune (unlimited history).
BACKUP_RETENTION=5
# reset-backup-<ts> folders kept per service (each `reset` keeps its verified
# pre-wipe snapshot there, outside BACKUP_RETENTION). -1 = unlimited.
RESET_BACKUP_RETENTION=5

# ── Docker backend ────────────────────────────────────────────────────────────
# 'subprocess' (default) needs no extra dependencies — calls docker/docker
# compose directly and parses their text output.
# 'python-on-whales' gives typed exceptions/structured errors instead of
# parsed CLI text for compose operations — same underlying docker CLI calls,
# clearer failure messages. Install first: uv sync --extra docker-sdk
# DOCKER_BACKEND=python-on-whales
