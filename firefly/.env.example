# Firefly III — Storage paths
DATA_ROOT=../service_data/data/firefly

# Postgres
POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=your_strong_password

# App key — must be exactly 32 characters (generate: openssl rand -base64 24 | tr -d '=+/' | cut -c1-32)
APP_KEY=PLEASE_CHANGE_ME_32_CHARACTERS_X

# Admin / site owner email
SITE_OWNER=your@email.com

# Cron token — must be exactly 32 alphanumeric characters (generate: openssl rand -hex 16)
STATIC_CRON_TOKEN=PLEASE_CHANGE_ME_32_CHARACTERS_X

# Data Importer — OAuth client (pre-fills the Client ID for all users)
# One-time setup: Firefly III → Profile → OAuth → OAuth Clients → Create new client
#   Name: anything, Redirect URL: https://firefly-import.yourdomain.com/callback
#   Uncheck "Keep a secret?" — then paste the Client ID UUID below
FIREFLY_III_CLIENT_ID=
