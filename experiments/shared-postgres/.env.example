# experiments/shared-postgres/.env — copy to .env (gitignored) and fill in.
# Throwaway credentials — this whole experiment is disposable, torn down
# with `docker compose down -v` when done. Not used by anything else.

# Shared Postgres superuser (creates the 3 app databases/roles below)
POSTGRES_SUPERUSER_PASSWORD=changeme_super

# One database + role per test app, all inside the ONE shared instance —
# this is the actual thing being tested
FIREFLY_TEST_DB=firefly_test
FIREFLY_TEST_USER=firefly_test
FIREFLY_TEST_PASSWORD=changeme_firefly

FORGEJO_TEST_DB=forgejo_test
FORGEJO_TEST_USER=forgejo_test
FORGEJO_TEST_PASSWORD=changeme_forgejo

GUACAMOLE_TEST_DB=guacamole_test
GUACAMOLE_TEST_USER=guacamole_test
GUACAMOLE_TEST_PASSWORD=changeme_guacamole
