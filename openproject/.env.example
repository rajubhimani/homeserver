# OpenProject — Storage paths
DATA_ROOT=../service_data/data/openproject

# Secret key (generate with: openssl rand -hex 64)
SECRET_KEY_BASE=your_secret_key_here

# Registration — 0=disabled, 2=email activation, 3=manual admin, 4=automatic
SELF_REGISTRATION=4

# Remaining OpenProject env vars (image defaults — not previously set, no behavior change)
OPENPROJECT_RAILS__CACHE__STORE=file_store
OPENPROJECT_ATTACHMENTS__STORAGE=file
OPENPROJECT_BACKUP__ENABLED=true
OPENPROJECT_SHOW__COMMUNITY__LINKS=true
OPENPROJECT_SECURITY__BADGE__DISPLAYED=true
OPENPROJECT_DISABLED__MODULES=[]
OPENPROJECT_WEB_TIMEOUT=60
OPENPROJECT_WEB_MIN__THREADS=4
OPENPROJECT_WEB_MAX__THREADS=16
