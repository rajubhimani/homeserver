# Cloudflare Tunnel token
# Get this from: https://one.dash.cloudflare.com → Networks → Tunnels → Create tunnel
# Select "Docker" as the connector type — the dashboard shows the exact token.
# One token per tunnel. Each tunnel can serve multiple public hostnames.
TUNNEL_TOKEN=your_tunnel_token_here

# Remaining cloudflared env vars (image defaults — not previously set, no behavior change)
TUNNEL_LOGLEVEL=info
TUNNEL_RETRIES=5
TUNNEL_GRACE_PERIOD=30s
TUNNEL_EDGE_IP_VERSION=4
