.DS_Store
# FUSE artifact left behind when a file is deleted while still open, e.g. by
# cloudflared-watchdog on the FUSE-mounted HDD (/mnt/mydata) — harmless, regenerates
.fuse_hidden*
/._data
/._immich
/._nextcloud
/._setup.md
service_data
# k8s pilot's placeholder test data (see kubernetes/README.md) — never real data
service_data-test/
# Moved out of the repo tree to /mnt/mydata/homeserver-local/ (symlinked back)
# so the repo dir can be relocated/deleted without touching these — same
# reasoning as service_data above. No trailing slash on .claude/.agents:
# a slash only matches real directories, not the symlinks these now are.
CLAUDE.md
AGENTS.md
TODO.md
.claude
.agents
.env
*.log
*.json
# services.json is the single source of truth for tiers + landing-page
# grouping (homeserver.py, services/landing/index.html both read it) — must
# override the blanket *.json ignore above or it silently never gets committed.
!services.json
!.vscode/settings.json
# Grafana's provisioned-as-code dashboards — checked in so they survive a
# fresh clone/install instead of only existing in a running service_data/.
# Without this override the blanket *.json ignore above silently excludes
# them: confirmed on this repo, cadvisor.json/node-exporter-full.json were
# on disk but had never actually been committed.
!services/observability/grafana/provisioning/dashboards/json/*.json
# scratch research notes (WebSearch findings, version/memory audits) —
# working notes for building a doc, not the doc itself
research/
*.pem
._*
*.sqlite
test/*

# Python (homeserver.py / uv) — uv.lock IS committed for reproducible installs
.venv/
__pycache__/
*.pyc