# Trilium Notes — Storage paths
DATA_ROOT=../service_data/data/trilium

# No signup/registration system — Trilium is single-user. Set the
# username/password through the setup wizard on first visit to the web UI.

# Remaining Trilium env vars (image defaults — not previously set, no behavior change)
TRILIUM_GENERAL_INSTANCENAME=
TRILIUM_GENERAL_NOAUTHENTICATION=false
TRILIUM_GENERAL_NOBACKUP=false
TRILIUM_GENERAL_NODESKTOPICON=false
TRILIUM_GENERAL_READONLY=false
TRILIUM_NETWORK_HOST=0.0.0.0
TRILIUM_NETWORK_PORT=8080
TRILIUM_NETWORK_HTTPS=false
TRILIUM_NETWORK_CERTPATH=
TRILIUM_NETWORK_KEYPATH=
TRILIUM_NETWORK_TRUSTEDREVERSEPROXY=
TRILIUM_NETWORK_CORSALLOWORIGIN=
TRILIUM_NETWORK_CORSALLOWMETHODS=
TRILIUM_NETWORK_CORSALLOWHEADERS=
TRILIUM_NETWORK_CORSRESOURCEPOLICY=same-origin
TRILIUM_SESSION_COOKIEMAXAGE=1814400
TRILIUM_SYNC_SYNCSERVERHOST=
TRILIUM_SYNC_SYNCSERVERTIMEOUT=120000
TRILIUM_SYNC_SYNCPROXY=
TRILIUM_LOGGING_RETENTIONDAYS=90
