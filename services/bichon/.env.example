# Bichon — all data (index, compressed mail blobs, metadata) lives in the
# bichon-data named volume, not under service_data/ — see compose.yml.

# Encrypts stored IMAP passwords / OAuth tokens (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Changing it later is NOT supported upstream — every account would need its
# credentials re-entered. Keep a copy somewhere safe (e.g. Vaultwarden).
BICHON_ENCRYPT_PASSWORD=your_hex_secret_here

# Plain (uncolored) logs — ANSI escape codes show up as garbage in Dozzle/Loki.
BICHON_ANSI_LOGS=false

# Remaining Bichon env vars (image defaults — not previously set, no behavior change)
BICHON_LOG_LEVEL=info
BICHON_WEBUI_TOKEN_EXPIRATION_HOURS=168
BICHON_ENABLE_SMTP=false
