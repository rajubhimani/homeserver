# SilverBullet — Storage paths
DATA_ROOT=../../service_data/data/silverbullet

# Basic-auth login for the single space (format: username:password)
SB_USER=admin:your_strong_password

# Remaining SilverBullet env vars (image defaults — not previously set, no behavior change)
SB_INDEX_PAGE=index
SB_SPACE_IGNORE=
SB_HTTP_LOGGING=
SB_LOG_PUSH=
SB_DISABLE_SERVICE_WORKER=
SB_HOSTNAME=0.0.0.0
SB_PORT=3000
SB_UNIX_SOCKET=
SB_URL_PREFIX=
SB_AUTH_TOKEN=
SB_LOCKOUT_LIMIT=10
SB_LOCKOUT_TIME=60
SB_REMEMBER_ME_HOURS=168
SB_READ_ONLY=
SB_SHELL_BACKEND=local
SB_SHELL_WHITELIST=
SB_METRICS_PORT=
SB_NAME=
SB_DESCRIPTION=
SB_RUNTIME_API=
SB_CHROME_PATH=
SB_CHROME_SHOW=
SB_CHROME_DATA_DIR=.chrome-data
SB_CHROME_LOG_CONSOLE=
