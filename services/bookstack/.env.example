# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# MariaDB
MYSQL_DATABASE=bookstack
MYSQL_USER=bookstack
MYSQL_PASSWORD=your_strong_password

# Laravel app key — generate with:
#   docker run --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:v26.09.1-ls287 \
#     -c "php /app/www/artisan key:generate --show"
APP_KEY=base64:your_generated_app_key

# Self-registration is admin-panel-only in BookStack (Settings > Registration
# after first login) — no env var toggle exists to set here.

# Remaining BookStack env vars (image defaults — not previously set, no behavior change)
TZ=Etc/UTC
UMASK=022
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
CACHE_DRIVER=file
STORAGE_TYPE=local
MAIL_DRIVER=smtp
MAIL_FROM_NAME=BookStack
MAIL_FROM=bookstack@example.com
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
AUTH_METHOD=standard
LDAP_SERVER=false
LDAP_BASE_DN=false
LDAP_DN=false
LDAP_PASS=false
LDAP_USER_FILTER=(&(uid={user}))
LDAP_VERSION=false
LDAP_START_TLS=false
LDAP_ID_ATTRIBUTE=uid
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_DISPLAY_NAME_ATTRIBUTE=cn
REVISION_LIMIT=100
RECYCLE_BIN_LIFETIME=30
FILE_UPLOAD_SIZE_LIMIT=50
API_DEFAULT_ITEM_COUNT=100
API_MAX_ITEM_COUNT=500
API_REQUESTS_PER_MIN=180
IP_ADDRESS_PRECISION=4

# Database host/port. Default: this stack's shared server. Point at a managed
# database (AWS RDS, Azure Flexible Server, GCP Cloud SQL...) to move it out; homeserver.py
# then stops managing it here (docs/10-new-services.md "Managed-cloud parity").
DB_HOST=shared-mariadb
DB_PORT=3306

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# BookStack — Storage paths
DATA_ROOT=../../service_data/data/bookstack

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret bookstack-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
