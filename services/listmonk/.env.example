# Listmonk — Storage paths
DATA_ROOT=../../service_data/data/listmonk

# Postgres
POSTGRES_DB=listmonk
POSTGRES_USER=listmonk
POSTGRES_PASSWORD=your_strong_password

# Super admin — auto-created on first start (installer is idempotent, safe
# to leave set on every subsequent start)
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=your_strong_password

# No other env vars to document here — Listmonk deliberately keeps everything
# beyond DB/app-address/admin-bootstrap (SMTP, privacy, uploads, rate limits,
# etc.) in the admin UI's Settings screen rather than env vars. Checked
# against the official config docs; there's nothing else to expose here.
