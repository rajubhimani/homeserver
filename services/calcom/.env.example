# Cal.com — Postgres
POSTGRES_DB=calcom
POSTGRES_USER=calcom
POSTGRES_PASSWORD=your_strong_password

# Session secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret

# Credential encryption key — generate with: openssl rand -base64 24
# NEVER change this after first run: doing so permanently corrupts every
# stored integration credential (Google OAuth tokens, calendar connections).
CALENDSO_ENCRYPTION_KEY=your_random_encryption_key

# Remaining Cal.com env vars (image defaults — not previously set, no behavior change)
EMAIL_FROM=calcom@example.com
EMAIL_SERVER_HOST=mailpit
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Database host/port. Default: this stack's shared server. Point at a managed
# database (AWS RDS, Azure Flexible Server, GCP Cloud SQL...) to move it out; homeserver.py
# then stops managing it here (docs/10-new-services.md "Managed-cloud parity").
DB_HOST=shared-postgres
DB_PORT=5432
