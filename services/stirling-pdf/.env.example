# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Authentication
SECURITY_ENABLELOGIN=true
SECURITY_INITIALLOGIN_USERNAME=admin
SECURITY_INITIALLOGIN_PASSWORD=changeme

# Remaining Stirling-PDF env vars (image defaults — not previously set, no behavior change)
SECURITY_JWT_TOKENEXPIRYMINUTES=1440
SYSTEM_SERVERCERTIFICATE_ENABLED=true
LEGAL_LOGINAGREEMENT_ENABLED=false
MAIL_ENABLED=false
UI_LOGOSTYLE=classic

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Stirling-PDF — Storage paths
DATA_ROOT=../../service_data/data/stirling-pdf

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret stirling-pdf-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
