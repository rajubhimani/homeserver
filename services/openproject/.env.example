# OpenProject — Storage paths
DATA_ROOT=../../service_data/data/openproject

# Secret key (generate with: openssl rand -hex 64)
SECRET_KEY_BASE=your_secret_key_here

# Registration — 0=disabled, 2=email activation, 3=manual admin, 4=automatic
SELF_REGISTRATION=4

# Admin account seeding — only takes effect on the very first startup (the
# initial `db:seeds` run that creates the database). Setting these on an
# already-running instance does nothing; change the password via the UI
# instead (Administration -> Users, or your own account settings).
# OPENPROJECT_SEED_ADMIN_USER_NAME=OpenProject Admin
# OPENPROJECT_SEED_ADMIN_USER_MAIL=admin@example.net
# OPENPROJECT_SEED_ADMIN_USER_PASSWORD=change_me_before_first_start
# OPENPROJECT_SEED_ADMIN_USER_PASSWORD_RESET=false

# Outgoing email — points at Mailpit (this stack's SMTP test-catcher,
# services/mailpit/) for testing; no real mail delivery.
OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
OPENPROJECT_SMTP__ADDRESS=mailpit
OPENPROJECT_SMTP__PORT=1025
OPENPROJECT_SMTP__AUTHENTICATION=none
OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=false

# Remaining OpenProject env vars (image defaults — not previously set, no behavior change)
OPENPROJECT_RAILS__CACHE__STORE=file_store
OPENPROJECT_ATTACHMENTS__STORAGE=file
OPENPROJECT_BACKUP__ENABLED=true
OPENPROJECT_SHOW__COMMUNITY__LINKS=true
OPENPROJECT_SECURITY__BADGE__DISPLAYED=true
OPENPROJECT_DISABLED__MODULES=[]
OPENPROJECT_WEB_TIMEOUT=60
OPENPROJECT_WEB_MIN__THREADS=4
OPENPROJECT_WEB_MAX__THREADS=16
