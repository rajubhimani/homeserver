# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Postgres
POSTGRES_DB=vikunja
POSTGRES_USER=vikunja
POSTGRES_PASSWORD=your_strong_password

# Signs JWT tokens — generate a long random string and keep it stable
# (rotating it invalidates every existing session)
VIKUNJA_SERVICE_SECRET=your_random_jwt_secret

# Self-registration — set to false to make this an invite-only/admin-provisioned instance
VIKUNJA_ENABLE_REGISTRATION=false

# SMTP — points at Mailpit (this stack's SMTP test-catcher,
# services/mailpit/) for testing; no real mail delivery.
VIKUNJA_MAILER_ENABLED=true
VIKUNJA_MAILER_HOST=mailpit
VIKUNJA_MAILER_PORT=1025
VIKUNJA_MAILER_USERNAME=
VIKUNJA_MAILER_PASSWORD=
VIKUNJA_MAILER_FROMEMAIL=vikunja@example.com
VIKUNJA_MAILER_FORCESSL=false

# Remaining Vikunja env vars (image defaults — not previously set, no behavior change)
VIKUNJA_SERVICE_TIMEZONE=GMT
VIKUNJA_SERVICE_MAXITEMSPERPAGE=50
VIKUNJA_SERVICE_JWTTTL=259200
VIKUNJA_FILES_MAXSIZE=20MB
VIKUNJA_BACKGROUNDS_ENABLED=true
VIKUNJA_RATELIMIT_ENABLED=false
VIKUNJA_LOG_LEVEL=INFO
VIKUNJA_SERVICE_ENABLETASKATTACHMENTS=true
VIKUNJA_SERVICE_ENABLETOTP=true

# Database host/port. Default: this stack's shared server. Point at a managed
# database (AWS RDS, Azure Flexible Server, GCP Cloud SQL...) to move it out; homeserver.py
# then stops managing it here (docs/10-new-services.md "Managed-cloud parity").
DB_HOST=shared-postgres
DB_PORT=5432

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Vikunja — Storage paths
DATA_ROOT=../../service_data/data/vikunja

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret vikunja-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
