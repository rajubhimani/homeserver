# Vikunja — Storage paths
DATA_ROOT=../../service_data/data/vikunja

# Postgres
POSTGRES_DB=vikunja
POSTGRES_USER=vikunja
POSTGRES_PASSWORD=your_strong_password

# Signs JWT tokens — generate a long random string and keep it stable
# (rotating it invalidates every existing session)
VIKUNJA_SERVICE_SECRET=your_random_jwt_secret

# Self-registration — set to false to make this an invite-only/admin-provisioned instance
VIKUNJA_ENABLE_REGISTRATION=true

# Remaining Vikunja env vars (image defaults — not previously set, no behavior change)
VIKUNJA_SERVICE_TIMEZONE=GMT
VIKUNJA_SERVICE_MAXITEMSPERPAGE=50
VIKUNJA_SERVICE_JWTTTL=259200
VIKUNJA_FILES_MAXSIZE=20MB
VIKUNJA_MAILER_ENABLED=false
VIKUNJA_BACKGROUNDS_ENABLED=true
VIKUNJA_RATELIMIT_ENABLED=false
VIKUNJA_LOG_LEVEL=INFO
VIKUNJA_SERVICE_ENABLETASKATTACHMENTS=true
VIKUNJA_SERVICE_ENABLETOTP=true
