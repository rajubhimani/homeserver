# Outline — Storage paths
DATA_ROOT=../../service_data/data/outline

# Postgres
POSTGRES_DB=outline
POSTGRES_USER=outline
POSTGRES_PASSWORD=your_strong_password

# Core secrets — generate with: openssl rand -hex 32
SECRET_KEY=your_random_64_char_hex_secret
UTILS_SECRET=your_random_64_char_hex_secret

FORCE_HTTPS=true

# SMTP (invitations/notification emails — login itself is OIDC-only, see
# below) — points at Mailpit (this stack's SMTP test-catcher,
# services/mailpit/) for testing; no real mail delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=outline@example.com
SMTP_SECURE=false

# Outline has NO built-in email/password login — it requires at least one
# OAuth/OIDC provider configured before anyone can log in. This stack already
# runs Authentik, so point Outline at it as an OIDC provider:
#   1. In Authentik: create an OAuth2/OIDC Provider + Application for Outline
#      (redirect URI: https://outline.${DOMAIN}/auth/oidc.callback)
#   2. Fill in the client ID/secret below from that provider
#   (OIDC_AUTH_URI / OIDC_TOKEN_URI / OIDC_USERINFO_URI are set in
#   compose.yml, derived from DOMAIN — no need to set them here)
OIDC_CLIENT_ID=your_authentik_client_id
OIDC_CLIENT_SECRET=your_authentik_client_secret
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=Authentik

# Remaining Outline env vars (image defaults — not previously set, no behavior change)
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
DATABASE_CONNECTION_POOL_MIN=
DATABASE_CONNECTION_POOL_MAX=
