# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# No login of its own — gated by Authentik forward-auth at the hub level
# (browser.${DOMAIN}), not a per-container credential. See
# docs/services/browser-hub.md.

TZ=Etc/UTC

# Remaining Chrome env vars (image defaults — not previously set, no behavior change)
CUSTOM_PORT=3000
CUSTOM_HTTPS_PORT=3001
CUSTOM_WS_PORT=8082
TITLE=Selkies
MAX_RES=15360x8640
NO_DECOR=false
NO_FULL=false
UMASK=022
DISABLE_IPV6=false
PIXELFLUX_WAYLAND=true
AUTO_GPU=false
DISABLE_ZINK=false
DISABLE_DRI3=false
DASHBOARD=selkies-dashboard
SELKIES_DESKTOP=false
NO_GAMEPAD=false
CHROME_CLI=

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Chrome — Storage paths
DATA_ROOT=../../service_data/data/chrome

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret chrome-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
