# Brave — Storage paths
DATA_ROOT=../../service_data/data/brave

# No login of its own — gated by Authentik forward-auth at the hub level
# (browser.${DOMAIN}), not a per-container credential. See
# docs/services/browser-hub.md.

TZ=Etc/UTC

# Remaining Brave env vars (image defaults — not previously set, no behavior change)
CUSTOM_PORT=3000
CUSTOM_HTTPS_PORT=3001
CUSTOM_WS_PORT=8082
TITLE=Selkies
MAX_RES=15360x8640
NO_DECOR=false
NO_FULL=false
UMASK=022
DISABLE_IPV6=false
PIXELFLUX_WAYLAND=true
AUTO_GPU=false
DISABLE_ZINK=false
DISABLE_DRI3=false
DASHBOARD=selkies-dashboard
SELKIES_DESKTOP=false
NO_GAMEPAD=false
