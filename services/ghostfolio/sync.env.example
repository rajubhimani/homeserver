# Ghostfolio <-> Firefly III sync — copy to sync.env (gitignored) and fill in.
# This file is sourced by sh: keep the quotes around any value with spaces.
# Used only by firefly-sync.sh; deliberately NOT ghostfolio's .env, so the
# Firefly token never ends up inside the ghostfolio container's environment.
# Full walkthrough: docs/services/ghostfolio.md → "Connecting to Firefly III".

# Firefly III → Options → Profile → OAuth → Personal Access Tokens → Create new token
FIREFLY_TOKEN=
# Your Ghostfolio security token (the one shown at sign-up)
GHOSTFOLIO_SECURITY_TOKEN=

# Bank/cash accounts: Firefly is the truth, Ghostfolio gets the balance.
# "firefly_account_id:ghostfolio_account_uuid" pairs, space-separated, in quotes.
CASH_MAP=""

# Investment accounts: Ghostfolio is the truth (market value), Firefly gets
# a gain/loss transaction for the difference so its net worth matches.
# Same pair format. Never put the same account in both maps.
INVEST_MAP=""

# Differences smaller than this (in the account's currency) are ignored,
# so daily price noise doesn't create a transaction every single day.
MIN_DELTA=100

# Names of the Firefly revenue/expense accounts and category the gain/loss
# transactions are booked against (created automatically on first use).
GAIN_ACCOUNT="Investment gains"
LOSS_ACCOUNT="Investment losses"
CATEGORY="Unrealized gains/losses"

# 1 = print what would change, write nothing
DRY_RUN=0
