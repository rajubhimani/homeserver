# Ghostfolio — everything (accounts, activities, market data) lives in the
# ghostfolio-postgres named volume; there is no file data, so no DATA_ROOT.

# Timezone (IANA name)
TZ=Asia/Kolkata

# Postgres
POSTGRES_DB=ghostfolio
POSTGRES_USER=ghostfolio
POSTGRES_PASSWORD=your_strong_password

# Redis (cache only) — generate: openssl rand -hex 24
REDIS_PASSWORD=your_strong_password

# Secrets — generate each with: openssl rand -hex 32
# Changing ACCESS_TOKEN_SALT later invalidates every user's security token.
ACCESS_TOKEN_SALT=PLEASE_CHANGE_ME
JWT_SECRET_KEY=PLEASE_CHANGE_ME

# Optional — CoinGecko key for more reliable crypto prices (free "Demo" tier works)
API_KEY_COINGECKO_DEMO=

# Remaining Ghostfolio env vars (image defaults — not previously set, no behavior change)
ENABLE_FEATURE_AUTH_TOKEN=true
ENABLE_FEATURE_MCP=false
REQUEST_TIMEOUT=2000
