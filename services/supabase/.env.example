# Supabase — Storage paths
DATA_ROOT=../../service_data/data/supabase

############
# Secrets — generate real values before first start with the official
# helper: bash generate-keys.sh (uses the same logic as upstream's
# utils/generate-keys.sh, copied into this directory) or by hand:
#   openssl rand -base64 48                 -> POSTGRES_PASSWORD, DASHBOARD_PASSWORD (truncate/adapt)
#   openssl rand -base64 48                 -> JWT_SECRET (32+ chars)
#   sign HS256 JWTs with that JWT_SECRET     -> ANON_KEY (role: anon), SERVICE_ROLE_KEY (role: service_role)
#   openssl rand -base64 48                 -> SECRET_KEY_BASE (64+ chars)
#   openssl rand -hex 8                     -> REALTIME_DB_ENC_KEY (exactly 16 chars)
#   openssl rand -hex 16                    -> VAULT_ENC_KEY (exactly 32 chars)
#   openssl rand -base64 24                 -> PG_META_CRYPTO_KEY
#   openssl rand -base64 24 (x2)            -> LOGFLARE_PUBLIC_ACCESS_TOKEN, LOGFLARE_PRIVATE_ACCESS_TOKEN
#   openssl rand -hex 8                     -> POOLER_TENANT_ID
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=your_generated_anon_jwt
SERVICE_ROLE_KEY=your_generated_service_role_jwt
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=your_strong_password
SECRET_KEY_BASE=your_random_64_char_plus_secret
REALTIME_DB_ENC_KEY=your_16_char_key
VAULT_ENC_KEY=your_32_char_key
PG_META_CRYPTO_KEY=your_32_char_plus_key
LOGFLARE_PUBLIC_ACCESS_TOKEN=your_random_secret
LOGFLARE_PRIVATE_ACCESS_TOKEN=your_random_secret
S3_PROTOCOL_ACCESS_KEY_ID=your_random_hex
S3_PROTOCOL_ACCESS_KEY_SECRET=your_random_hex

# Opaque API keys / asymmetric JWKs — left blank (legacy HS256 keys above are
# used instead); see https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# URLs
############
SUPABASE_PUBLIC_URL=https://supabase.yourdomain.com
API_EXTERNAL_URL=https://supabase.yourdomain.com
SITE_URL=https://supabase.yourdomain.com
ADDITIONAL_REDIRECT_URLS=

############
# Database / Supavisor pooler
############
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your_random_tenant_id
POOLER_DB_POOL_SIZE=5

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project
OPENAI_API_KEY=

############
# Auth (GoTrue)
############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@yourdomain.com
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Storage
############
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

############
# Functions (Edge Runtime)
############
FUNCTIONS_VERIFY_JWT=false

############
# API (PostgREST)
############
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# imgproxy
############
IMGPROXY_AUTO_WEBP=true

############
# Remaining Supabase env vars (image defaults — not previously set, no
# behavior change). These require pairing with matching commented-out
# GOTRUE_EXTERNAL_*/GOTRUE_SMS_*/GOTRUE_MFA_*/GOTRUE_SAML_* lines in
# supabase-auth's environment block in compose.yml to actually take effect —
# uncommenting only here does nothing on its own. Kept as documentation of
# what's available, matching upstream's own .env.example structure.
############

# OAuth / social login providers
# GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=
# GITHUB_ENABLED=false
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=
# AZURE_ENABLED=false
# AZURE_CLIENT_ID=
# AZURE_SECRET=

# Phone / SMS provider (Twilio)
# SMS_PROVIDER=twilio
# SMS_OTP_EXP=60
# SMS_OTP_LENGTH=6
# SMS_MAX_FREQUENCY=60s
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_MESSAGE_SERVICE_SID=

# Multi-factor authentication
# MFA_TOTP_ENROLL_ENABLED=true
# MFA_TOTP_VERIFY_ENABLED=true
# MFA_PHONE_ENROLL_ENABLED=false
# MFA_PHONE_VERIFY_ENABLED=false
# MFA_MAX_ENROLLED_FACTORS=10

# SAML SSO
# SAML_ENABLED=true
# SAML_PRIVATE_KEY=
# SAML_ALLOW_ENCRYPTED_ASSERTIONS=false
# SAML_RELAY_STATE_VALIDITY_PERIOD=2m0s
# SAML_RATE_LIMIT_ASSERTION=15

# Logs/analytics (Vector + Logflare) — not deployed in this stack's compose
# (see docs/services/supabase.md); these are inert without that add-on
# GOOGLE_PROJECT_ID=
# GOOGLE_PROJECT_NUMBER=
