# wg-easy — Self-hosted WireGuard VPN with web UI
DATA_ROOT=../../service_data/data/wg-easy

# v15 uses a first-run setup wizard in the web UI to set the public host
# address, port, and admin password — no env vars needed here for that.
#
# IMPORTANT: this service also requires one-time HOST-level setup (sysctls,
# kernel modules, firewalld masquerade) and an "Interface -> Device" fix in
# the admin UI after first start. See docs/services/wg-easy.md — none of
# this works out of the box without those steps.
#
# Access the admin UI at http://<homeserver-lan-ip>:51821 (LAN-only,
# deliberately not exposed via nginx-plain/Cloudflare).
