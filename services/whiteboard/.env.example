# Secret shared between Nextcloud's "Whiteboard" app and this backend
# server. Must be entered verbatim as the "Shared secret" in Nextcloud's
# Settings -> Administration -> Whiteboard admin page (or via
# occ config:app:set whiteboard jwt_secret_key --value="<this>"), or
# real-time whiteboard collaboration fails to connect. Generate with:
# openssl rand -hex 32
JWT_SECRET_KEY=your_strong_jwt_secret

# Remaining Whiteboard env vars (image defaults — not previously set, no behavior change)
PORT=3002
STORAGE_STRATEGY=lru
MAX_UPLOAD_FILE_SIZE=2
COMPRESSION_ENABLED=true
FORCE_CLOSE_TIMEOUT=3600000
