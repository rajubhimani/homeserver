# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Postgres
POSTGRES_DB=wallabag
POSTGRES_USER=wallabag
POSTGRES_PASSWORD=your_strong_password

# Symfony app secret — generate a long random string
SYMFONY__ENV__SECRET=your_random_secret

# Self-registration
SYMFONY__ENV__FOSUSER_REGISTRATION=false

# SYMFONY__ENV__MAILER_DSN is actively set (unlike the rest of this
# "remaining vars" block) — points at Mailpit (this stack's SMTP
# test-catcher, services/mailpit/) for testing; no real mail delivery.
SYMFONY__ENV__MAILER_DSN=smtp://mailpit:1025

# Remaining Wallabag env vars (image defaults — not previously set, no behavior change)
SYMFONY__ENV__LOCALE=en
SYMFONY__ENV__FROM_EMAIL=wallabag@example.com

# Database host/port. Default: this stack's shared server. Point at a managed
# database (AWS RDS, Azure Flexible Server, GCP Cloud SQL...) to move it out; homeserver.py
# then stops managing it here (docs/10-new-services.md "Managed-cloud parity").
DB_HOST=shared-postgres
DB_PORT=5432

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Wallabag — Storage paths
DATA_ROOT=../../service_data/data/wallabag

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret wallabag-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
