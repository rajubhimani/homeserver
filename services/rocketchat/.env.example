# Rocket.Chat — Storage paths (only file uploads; MongoDB is a named volume)
DATA_ROOT=../../service_data/data/rocketchat

# Image tags — pin explicitly. Check for updates:
#   https://hub.docker.com/r/rocketchat/rocket.chat/tags (or registry.rocket.chat)
#   https://hub.docker.com/r/mongodb/mongodb-community-server/tags
#   https://hub.docker.com/_/nats/tags
ROCKETCHAT_VERSION=8.7.0
MONGODB_VERSION=8.2-ubi8
NATS_VERSION=2.14.6-alpine

# MongoDB replica set — required by Rocket.Chat (oplog tailing for
# real-time updates), even for a single instance. Not meant to be changed;
# exists here only because both mongodb-init and rocketchat reference the
# same value and it shouldn't be typed twice.
MONGODB_REPLICA_SET_NAME=rs0

# uid the mongodb-community-server image runs as internally — matches the
# image's own default, not meant to be changed casually.
MONGODB_USER_ID=1001

# Outgoing email — points at Mailpit (this stack's SMTP test-catcher,
# services/mailpit/) for testing; no real mail delivery. OVERWRITE_SETTING_
# forces these via env, overriding anything set through the admin UI.
OVERWRITE_SETTING_SMTP_Host=mailpit
OVERWRITE_SETTING_SMTP_Port=1025
OVERWRITE_SETTING_From_Email=rocketchat@example.com

# Remaining Rocket.Chat env vars (image defaults — not previously set, no
# behavior change). Unlike Mattermost/Airflow, most Rocket.Chat settings
# are DB-stored (Admin UI or REST API), not env-var driven — this is the
# actual bootstrap-time surface, verified against
# https://docs.rocket.chat/docs/environment-variables. First admin account
# here was created via the setup wizard in the browser instead of these
# (see docs/services/rocketchat.md); set INITIAL_USER=yes + the rest below
# to automate that on a fresh install instead.
INITIAL_USER=
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=
# Registers with a specific Rocket.Chat Cloud account instead of the
# per-install manual flow this stack disables by default (see
# docs/services/rocketchat.md's Notes) — leave blank unless you want that.
REG_TOKEN=
# Prometheus metrics — deliberately not scraped in this stack (see
# docs/services/rocketchat.md's Notes on why the official exporters were
# left out), but the app itself can still expose the endpoint.
OVERWRITE_SETTING_Prometheus_Enabled=false
