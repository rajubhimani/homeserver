# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Default is a regenerable cache under service_data/. For speed, point this at a fast SSD path
# (absolute, e.g. MODELS_ROOT=/home/<user>/ollama-models) — model load time is disk-bound.
MODELS_ROOT=../../service_data/cache/ollama

# Remaining Ollama env vars (image defaults — not previously set, no behavior change)
OLLAMA_HOST=0.0.0.0:11434
# Memory: one model in RAM at a time, unloaded 5 min after last use (Ollama's defaults keep up to 3
# loaded for 5 min, so a big model you stopped using still holds RAM after you switch).
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_DEBUG=INFO
OLLAMA_FLASH_ATTENTION=false
OLLAMA_MAX_QUEUE=512
OLLAMA_NOPRUNE=false

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Ollama — Storage paths
# DATA_ROOT is injected by homeserver.py but unused by this service — all
# state (including downloaded models, which can be tens of GB) lives in
# MODELS_ROOT instead, outside service_data/data/ so it's never swept into
# the config-only backup snapshot.
DATA_ROOT=../../service_data/data/ollama

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret ollama-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
