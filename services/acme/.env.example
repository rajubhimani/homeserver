# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Contact address Let's Encrypt can use for expiry notices. Required: acme idles until it is set.
ACME_EMAIL=

# Cloudflare API token for the DNS-01 challenge (how Let's Encrypt checks you own the domain
# without any inbound port). Create it at dash.cloudflare.com -> My Profile -> API Tokens ->
# Create Custom Token with two permissions, limited to this one zone:
#   Zone / DNS / Edit      and      Zone / Zone / Read
# Required: acme idles until it is set.
CLOUDFLARE_DNS_API_TOKEN=

# Which CA to ask. Start with the staging CA (untrusted test certificates, generous rate limits),
# check `docker logs acme`, then switch to production and restart acme: it then issues a fresh
# certificate (each CA keeps its own state). Shortcodes: letsencrypt-staging | letsencrypt
ACME_SERVER=letsencrypt-staging

# ACME certificate profile ('' = the CA's default, i.e. "classic"). Let's Encrypt moves the classic
# profile from 90 to 64 days on 2027-02-10 and to 45 days on 2028-02-16; renewal follows on its own.
ACME_PROFILE=

# Days left at which to renew. 0 = lego decides from the certificate's lifetime (a third left).
ACME_RENEW_DAYS=0

# Seconds between checks (a check does nothing until a renewal is due) and between retries after a failure.
ACME_CHECK_INTERVAL=43200
ACME_RETRY_INTERVAL=3600

# Remaining acme env vars (defaults — not previously set, no behavior change)
ACME_DNS_PROVIDER=cloudflare
# Wait this long after creating the TXT record instead of polling DNS (e.g. 60s). '' = poll.
ACME_PROPAGATION_WAIT=
# Extra flags passed to lego before `run` (space separated).
ACME_LEGO_ARGS=

# nginx-plain's certificate directory (the same one nginx-plain mounts at /etc/nginx/certs). Not
# auto-injected, unlike DATA_ROOT: keep it in step with nginx-plain's DATA_ROOT.
CERTS_DIR=../../service_data/data/nginx-plain/certs

# Not ported (see kubernetes/scope.yaml): cert-manager would issue certificates there.

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# acme — Storage paths
DATA_ROOT=../../service_data/data/acme

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret acme-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
