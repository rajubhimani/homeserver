# Mealie — Storage paths
DATA_ROOT=../../service_data/data/mealie

# Postgres
POSTGRES_DB=mealie
POSTGRES_USER=mealie
POSTGRES_PASSWORD=your_strong_password


# Registration — set to false to disable, true to allow
ALLOW_SIGNUP=true

# Outgoing email (invites/password resets) — points at Mailpit (this stack's
# SMTP test-catcher, services/mailpit/) for testing; no real mail delivery.
# No auth needed, so SMTP_AUTH_STRATEGY=NONE (Mailpit doesn't support TLS).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH_STRATEGY=NONE
SMTP_FROM_NAME=Mealie
SMTP_FROM_EMAIL=mealie@example.com
SMTP_USER=
SMTP_PASSWORD=

# Remaining Mealie env vars (image defaults — not previously set, no behavior change)
LOG_LEVEL=info
ALLOW_PASSWORD_LOGIN=true
API_DOCS=True
TOKEN_TIME=48
DAILY_SCHEDULE_TIME=23:45
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_USER_LOCKOUT_TIME=24
UVICORN_WORKERS=1
PUID=911
PGID=911
TZ=UTC
