# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Dev/prod host ports (see docs/11-services-reference.md before changing)
GRAFANA_PORT=8134
PROMETHEUS_PORT=8135

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Grafana SMTP (alerting emails) — points at Mailpit (this stack's SMTP
# test-catcher, services/mailpit/) for testing; no real mail delivery.
GRAFANA_SMTP_HOST=mailpit:1025
GRAFANA_SMTP_FROM=observability@example.com

# How long metrics/logs are kept before being deleted — bounds backup size
# since this data isn't regenerable. Prometheus format: 15d, 336h, etc.
# Loki format must be in hours (336h = 14d).
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=336h

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Injected automatically by homeserver.py as an absolute path — this value
# is only a fallback for running `docker compose` directly.
DATA_ROOT=../../service_data/data/observability

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret observability-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
