# Mattermost — Storage paths
DATA_ROOT=../../service_data/data/mattermost

# Postgres
POSTGRES_DB=mattermost
POSTGRES_USER=mattermost
POSTGRES_PASSWORD=your_strong_password

# Image tag — pin explicitly, check https://hub.docker.com/r/mattermost/mattermost-team-edition/tags for updates
MATTERMOST_VERSION=11.10.0

# Anyone can self-register an account on this server by default (no invite
# needed). Set to false if you want admin-provisioned accounts only.
MM_TEAMSETTINGS_ENABLEOPENSERVER=true
MM_TEAMSETTINGS_ENABLEUSERCREATION=true

# Outgoing email — points at Mailpit (this stack's SMTP test-catcher,
# services/mailpit/) for testing; no real mail delivery.
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=true
MM_EMAILSETTINGS_SMTPSERVER=mailpit
MM_EMAILSETTINGS_SMTPPORT=1025
MM_EMAILSETTINGS_ENABLESMTPAUTH=false
MM_EMAILSETTINGS_CONNECTIONSECURITY=
MM_EMAILSETTINGS_FEEDBACKEMAIL=mattermost@example.com

# Remaining Mattermost env vars (image defaults — not previously set, no
# behavior change). Verified live via `mmctl config get <Section> --local`
# against this stack's own running instance, not just docs.
MM_TEAMSETTINGS_MAXUSERSPERTEAM=50
MM_TEAMSETTINGS_MAXCHANNELSPERTEAM=2000
MM_TEAMSETTINGS_RESTRICTCREATIONTODOMAINS=
MM_PASSWORDSETTINGS_MINIMUMLENGTH=8
MM_PASSWORDSETTINGS_LOWERCASE=false
MM_PASSWORDSETTINGS_NUMBER=false
MM_PASSWORDSETTINGS_UPPERCASE=false
MM_PASSWORDSETTINGS_SYMBOL=false
MM_RATELIMITSETTINGS_ENABLE=false
MM_RATELIMITSETTINGS_PERSEC=10
MM_RATELIMITSETTINGS_MAXBURST=100
MM_FILESETTINGS_MAXFILESIZE=104857600
MM_FILESETTINGS_ENABLEPUBLICLINK=false
MM_LOGSETTINGS_ENABLECONSOLE=true
MM_LOGSETTINGS_CONSOLELEVEL=DEBUG
