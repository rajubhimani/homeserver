# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Second login, behind Authentik. Use HASHED_PASSWORD instead (leave this
# empty then): echo -n 'pw' | npx argon2-cli -e
PASSWORD=your_strong_password
HASHED_PASSWORD=

# code-server release (the image is built on it, see Dockerfile). No LTS track:
# the newest stable.
CODE_SERVER_VERSION=4.140.0
# uv (Python package/project manager), baked into the image. No LTS track:
# the newest stable.
UV_VERSION=0.12.24
# Node.js, baked into the image: the Active LTS line (24).
NODE_VERSION=24.21.0
# GitHub CLI, baked into the image (GitHub's own release, checksum-verified;
# Debian's package is far behind). No LTS track: the newest stable.
GH_VERSION=2.102.0
# Debian packages baked into the image (developer essentials). Edit the list
# and rebuild the image to change it; git, curl and ssh are already in the base.
DEV_PACKAGES=build-essential python3 python3-venv python3-pip pkg-config jq ripgrep fd-find unzip zip rsync less vim htop procps wget ca-certificates cmake tmux git-lfs sqlite3 postgresql-client tree bat

# Docker Engine for the sidecar and the CLI in the editor (same version for
# both). No LTS track: the newest stable.
DOCKER_VERSION=29.8.2

# Remaining code-server env vars (image defaults — not previously set, no behavior change)
CS_DISABLE_PROXY=
CS_DISABLE_GETTING_STARTED_OVERRIDE=
CODE_SERVER_IDLE_TIMEOUT_SECONDS=
CODE_SERVER_RECONNECTION_GRACE_TIME=10800
LOG_LEVEL=
EXTENSIONS_GALLERY=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# The directory opened as /home/coder/project (default: this repo). Any
# host path works; it must be readable and writable by uid 1000.
WORKSPACE_ROOT=../..
# The sidecar's images/containers/build cache. Regenerable, can grow large, so
# it sits in the cache bucket and is never part of a snapshot.
DOCKER_ROOT=../../service_data/cache/code-server/docker

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# code-server — Storage paths
DATA_ROOT=../../service_data/data/code-server

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret code-server-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
