# Mail-Archiver — Storage paths
DATA_ROOT=../../service_data/data/mail-archiver

# Timezone (IANA name — used for how dates are displayed in the UI)
TZ=Asia/Kolkata

# Postgres — this database IS the archive (message bodies + attachments)
POSTGRES_DB=mailarchiver
POSTGRES_USER=mailarchiver
POSTGRES_PASSWORD=your_strong_password

# Admin account (created on first start)
MAIL_ARCHIVER_ADMIN_USER=admin
MAIL_ARCHIVER_ADMIN_PASSWORD=your_strong_password

# Sync schedule — how often every account is checked for new mail, and how
# often a full (not just incremental) resync runs to catch moved/deleted mail.
MailSync__IntervalMinutes=15
MailSync__FullSyncIntervalHours=24

# Deletion lock — set false to make archived mail impossible to delete from
# the UI (local retention policies still run). Good once you trust the setup.
DeletionPolicy__DeletionAllowed=true

# Don't load remote images / tracking pixels when viewing archived mail.
View__BlockExternalResources=true

# Remaining Mail-Archiver env vars (image defaults — not previously set, no behavior change)
Authentication__SessionTimeoutMinutes=60
MailSync__MaxConcurrentSyncs=1
MailSync__IgnoreSelfSignedCert=false
View__DefaultToPlainText=true
Upload__MaxFileSizeGB=10
Api__Enabled=false
Mcp__Enabled=false
Logging__LogLevel__Default=Information
