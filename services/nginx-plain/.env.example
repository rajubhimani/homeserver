# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Your domain — injected into all server_name directives at startup
DOMAIN=yourdomain.com

# DNS resolver — Docker: 127.0.0.11 / Podman: gateway of the homeserver network (usually 10.89.0.1)
NGINX_RESOLVER=127.0.0.11

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# nginx-plain — Storage paths
DATA_ROOT=../../service_data/data/nginx-plain

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret nginx-plain-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
