# nginx-plain — Storage paths
DATA_ROOT=../../service_data/data/nginx-plain

# Your domain — injected into all server_name directives at startup
DOMAIN=yourdomain.com

# DNS resolver — Docker: 127.0.0.11 / Podman: gateway of the homeserver network (usually 10.89.0.1)
NGINX_RESOLVER=127.0.0.11

# Browser Hub login is set in the repo ROOT .env (BROWSER_HUB_USER/PASSWORD)
# — not here. homeserver.py's injected value always overrides anything in
# this file for that key, so keeping a second copy here would just be a
# second place for it to (confusingly) go stale. See docs/services/browser-hub.md.
