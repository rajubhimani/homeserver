        proxy_set_header X-Forwarded-For $real_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        # Plausible's UI is Phoenix LiveView — account creation, the
        # dashboard, etc. run over a WebSocket, not plain HTTP requests.
        # Without these, nginx proxies as HTTP/1.0 with Connection: close,
        # so the LiveView socket handshake never completes and the page
