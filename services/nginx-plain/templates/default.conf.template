# ── wg-easy (VPN Admin Panel) ──────────────────────────────────────────────
# wg-easy uses network_mode: host (needed to bind WireGuard's UDP port
# directly on the host's real IPv6 address — see docs/services/wg-easy.md),
# so it isn't on the `homeserver` Docker network like other containers.
# Reached here via the network's own bridge gateway IP (172.18.0.1), which
# is just another host interface wg-easy's host networking already binds to.
# This route carries ONLY the admin web UI (plain HTTP/REST) — the actual
# WireGuard VPN tunnel traffic (UDP 51820) never touches Cloudflare at all,
# so this does not raise the same VPN-proxying ToS concern that ruled out
# exposing NetBird/Headscale this way earlier.
server {
    listen 80;
    access_log /var/log/nginx/access.log cf_combined;
    server_name wg-admin.${DOMAIN};

    # Authentik forward-auth — see docs/services/authentik.md
    auth_request /outpost.goauthentik.io/auth/nginx;
    error_page 401 = @goauthentik_proxy_signin;
    auth_request_set $auth_cookie $upstream_http_set_cookie;
    add_header Set-Cookie $auth_cookie;

    location / {
        set $upstream http://172.18.0.1:51821;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $real_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /outpost.goauthentik.io {
        internal;
        set $authentik_upstream http://authentik-server:9000;
        proxy_pass $authentik_upstream$uri;
        proxy_set_header Host $host;
        proxy_set_header X-Original-URL https://$http_host$request_uri;
        proxy_set_header X-Forwarded-For $real_client_ip;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie;
    }

    location @goauthentik_proxy_signin {
        internal;
        add_header Set-Cookie $auth_cookie;
        return 302 https://authentik.${DOMAIN}/outpost.goauthentik.io/start?rd=https://$http_host$request_uri;
    }
}

