        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Plausible's UI is Phoenix LiveView — account creation, the
        # dashboard, etc. run over a WebSocket, not plain HTTP requests.
        # Without these, nginx proxies as HTTP/1.0 with Connection: close,
        # so the LiveView socket handshake never completes and the page
        # just hangs (e.g. "Create my account" does nothing, no error).
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

