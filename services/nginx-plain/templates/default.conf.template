# Auto-generated from template — domain injected from DOMAIN env var at startup
# Use Docker's internal DNS — resolves container names at request time
resolver ${NGINX_RESOLVER} valid=10s;

# Only send "Connection: upgrade" to the upstream on an actual WebSocket
# handshake. A hardcoded "upgrade" breaks keepalive/reuse for the plain HTTP
# requests a mixed location (app + WS tunnel, e.g. Guacamole) also serves.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Real client IP for traffic arriving via Cloudflare Tunnel. $remote_addr at
# this layer is always cloudflared's own container IP (confirmed live) —
# CF-Connecting-IP is the header Cloudflare's edge always sets accurately to
# the actual visitor IP, and cloudflared preserves it end to end. Falls back
# to $remote_addr for direct dev-port access that bypasses Cloudflare entirely.
map $http_cf_connecting_ip $real_client_ip {
    default $http_cf_connecting_ip;
    ''      $remote_addr;
}

# Same field shape as nginx's built-in "combined" format, just with
# $real_client_ip instead of $remote_addr — CrowdSec's bundled nginx parser
# (services/crowdsec/, crowdsec.labels.type=nginx on this container) expects
# that exact shape, so only the IP source changes, not the log structure.
# NOT set at http level: multiple access_log directives at the SAME context
# level accumulate (both fire, doubling every request) rather than the later
# one replacing the earlier one — confirmed live. A child context's directive
# (server-level, below) correctly overrides what it would otherwise inherit
# from http, so this format is applied per-server-block instead.
log_format cf_combined '$real_client_ip - $remote_user [$time_local] '
                        '"$request" $status $body_bytes_sent '
                        '"$http_referer" "$http_user_agent"';

# ── Internal health check — never proxied, used by Docker healthcheck ─────────
server {
    listen 80;
    access_log /var/log/nginx/access.log cf_combined;
    server_name _;
    location /_health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
    location / {
        return 444;
    }
}

# ── Landing page ──────────────────────────────────────────────────────────────
server {
    listen 80;
    access_log /var/log/nginx/access.log cf_combined;
    server_name ${DOMAIN};
    return 301 https://www.${DOMAIN}$request_uri;
}

server {
    listen 80;
    access_log /var/log/nginx/access.log cf_combined;
    server_name www.${DOMAIN};
    location / {
        set $upstream http://landing:80;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $real_client_ip;
        proxy_set_header X-Forwarded-For $real_client_ip;
        proxy_set_header X-Forwarded-Proto https;
    }
}

