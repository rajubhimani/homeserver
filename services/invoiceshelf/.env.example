# InvoiceShelf — Storage paths
DATA_ROOT=../../service_data/data/invoiceshelf

# MariaDB
MYSQL_DATABASE=invoiceshelf
MYSQL_USER=invoiceshelf
MYSQL_PASSWORD=your_strong_password
MYSQL_ROOT_PASSWORD=your_strong_root_password

# Laravel app key (generate with: echo "base64:$(openssl rand -base64 32)")
APP_KEY=base64:your_app_key_here

# The image auto-runs `php artisan migrate` on every container boot by
# default (serversideup/php's "Laravel automations" entrypoint script, gated
# by AUTORUN_ENABLED=true). That races the web install wizard: migrations
# populate the schema before the wizard ever runs, so its "database must be
# empty" check fails on first login with a false "SQLSTATE... Connection
# refused"-adjacent state (empty users/companies but a fully-migrated schema).
# InvoiceShelf's own official docker-compose disables this for exactly this
# reason — the wizard is what's supposed to run migrations, not the boot
# automation. See docs/services/invoiceshelf.md.
AUTORUN_LARAVEL_MIGRATION=false

# Remaining InvoiceShelf env vars (image defaults — not previously set, no behavior change)
APP_ENV=production
APP_DEBUG=false
APP_NAME=InvoiceShelf
APP_TIMEZONE=UTC
APP_LOCALE=en
DOMPDF_ENABLE_REMOTE=false
TRUSTED_PROXIES=*
