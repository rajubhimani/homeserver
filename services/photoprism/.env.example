# PhotoPrism — Storage paths
# DATA_ROOT holds config/cache/thumbnails only. The actual photo/video
# library (ORIGINALS_ROOT) is a large, irreplaceable media library, so per
# this stack's convention (see immich/jellyfin) it lives under
# service_data/media/ instead — kept out of DATA_ROOT so the automatic
# backup/snapshot on every `down` doesn't re-archive the whole photo library
# every time.
DATA_ROOT=../../service_data/data/photoprism
ORIGINALS_ROOT=../../service_data/media/photoprism

# MariaDB
MARIADB_DATABASE=photoprism
MARIADB_USER=photoprism
MARIADB_PASSWORD=your_strong_password
MARIADB_ROOT_PASSWORD=your_strong_root_password

# Admin account — min 8 characters, set before first start (changing it later
# requires the photoprism CLI, not this env var)
PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=your_strong_password

# Remaining PhotoPrism env vars (image defaults — not previously set, no behavior change)
PHOTOPRISM_DISABLE_TENSORFLOW=false
PHOTOPRISM_DETECT_NSFW=false
PHOTOPRISM_UPLOAD_NSFW=true
PHOTOPRISM_WORKERS=2
