# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
CACHE_ROOT=../../service_data/cache/clamav/db

# How many days the signature database can go without updating before the
# Docker healthcheck fails. Catches freshclam silently failing (network,
# DNS, rate-limiting) -- without this, a dead freshclam doesn't crash
# anything, so the container would report "healthy" indefinitely on
# months-stale signatures. Default 3 = at least two missed daily checks
# in a row before this fires, not a one-off blip. See healthcheck.sh.
CLAMAV_MAX_SIGNATURE_AGE_DAYS=3

# Remaining ClamAV env vars (image defaults — not previously set, no behavior change)
# Seconds to wait for clamd to finish starting (first run downloads the full
# signature database, which can take a while) before the container's own
# startup is considered failed.
CLAMD_STARTUP_TIMEOUT=1800
# How many times per day freshclam checks for signature updates.
FRESHCLAM_CHECKS=1

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# ClamAV — Storage paths
# DATA_ROOT is injected by homeserver.py but unused by this service — the
# only thing this container persists is the virus-signature database, fully
# regenerable via freshclam re-download, so it lives in CACHE_ROOT instead
# (service_data/cache/, never service_data/data/ — see the
# homeserver-add-service skill's data-bucket rules).
DATA_ROOT=../../service_data/data/clamav

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret clamav-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
