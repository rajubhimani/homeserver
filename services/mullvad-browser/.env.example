# Mullvad Browser — Storage paths
DATA_ROOT=../../service_data/data/mullvad-browser

# No login of its own — gated by Authentik forward-auth at the hub level
# (browser.${DOMAIN}), not a per-container credential. See
# docs/services/browser-hub.md.

TZ=Etc/UTC

# Remaining Mullvad Browser env vars (image defaults — not previously set, no behavior change)
# LOCAL_NET: CIDR range(s) to allow the browser to reach on your LAN despite
# its anti-fingerprinting network isolation — leave unset unless you need it.
LOCAL_NET=
CUSTOM_PORT=3000
CUSTOM_HTTPS_PORT=3001
CUSTOM_WS_PORT=8082
TITLE=Selkies
MAX_RES=15360x8640
NO_DECOR=false
NO_FULL=false
UMASK=022
DISABLE_IPV6=false
PIXELFLUX_WAYLAND=true
AUTO_GPU=false
DISABLE_ZINK=false
DISABLE_DRI3=false
DASHBOARD=selkies-dashboard
SELKIES_DESKTOP=false
NO_GAMEPAD=false
