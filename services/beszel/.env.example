# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Agent pairing — leave blank for the first start. Once the hub is up, log in,
# create a system (or a universal token under Settings → Tokens), copy the
# token + public key it gives you, paste them below, then restart the agent:
#   uv run homeserver.py dev up beszel
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
DATA_ROOT=../../service_data/data/beszel

# The hub's address as the agent sees it. The agent runs on the host network,
# so under Compose that's the hub's host-published port (compose.dev.yml /
# compose.prod.yml); update it if that port mapping changes.
HUB_URL=http://localhost:8106

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret beszel-env, and kubernetes/generate.py sets what differs:
#   HUB_URL=http://beszel:8090
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
