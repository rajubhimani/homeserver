# Mailpit — Storage paths
DATA_ROOT=../../service_data/data/mailpit

# Image tag — pin explicitly, check https://hub.docker.com/r/axllent/mailpit/tags for updates
MAILPIT_VERSION=v1.31.0

# SMTP catcher, not a real mail server — every service in this stack can
# point its SMTP setting at mailpit:1025 (internal, no auth) and receive
# nothing back but a place to see what it would have sent. Nothing here
# ever leaves this host, no real delivery, no MX records, no port 25 open
# to the internet. Web UI shows caught mail: https://mailpit.${DOMAIN}

# Remaining Mailpit env vars (image defaults — not previously set, no
# behavior change). Verified against https://mailpit.axllent.org/docs/configuration/runtime-options/
MP_DISABLE_WAL=false
MP_DISABLE_VERSION_CHECK=false
MP_DISABLE_AUTO_VACUUM=false
MP_COMPRESSION=1
MP_LABEL=
MP_TENANT_ID=
MP_MAX_MESSAGES=500
MP_MAX_AGE=
MP_MAX_MESSAGE_SIZE=50
MP_USE_MESSAGE_DATES=false
MP_IGNORE_DUPLICATE_IDS=false
MP_LOG_FILE=
MP_QUIET=false
MP_VERBOSE=false
MP_WEBROOT=/
MP_UI_AUTH_FILE=
MP_UI_TLS_CERT=
MP_UI_TLS_KEY=
MP_API_CORS=
MP_BLOCK_REMOTE_CSS_AND_FONTS=false
MP_ALLOW_INTERNAL_HTTP_REQUESTS=false
MP_DISABLE_LINK_CHECK_RATE_LIMIT=false
MP_ENABLE_SPAMASSASSIN=false
MP_ALLOW_UNTRUSTED_TLS=false
MP_DISABLE_HTTP_COMPRESSION=false
MP_HIDE_DELETE_ALL_BUTTON=false
MP_SEND_API_AUTH_FILE=
MP_SEND_API_AUTH_ACCEPT_ANY=false
MP_SMTP_AUTH_FILE=
MP_SMTP_TLS_CERT=
MP_SMTP_TLS_KEY=
MP_SMTP_REQUIRE_STARTTLS=false
MP_SMTP_REQUIRE_TLS=false
MP_SMTP_STRICT_RFC_HEADERS=false
MP_SMTP_MAX_RECIPIENTS=100
MP_SMTP_ALLOWED_RECIPIENTS=
MP_SMTP_IGNORE_REJECTED_RECIPIENTS=
MP_SMTP_DISABLE_RDNS=false
MP_SMTP_RELAY_CONFIG=
MP_SMTP_RELAY_ALL=false
MP_SMTP_RELAY_MATCHING=
MP_SMTP_FORWARD_CONFIG=
MP_ENABLE_CHAOS=false
MP_CHAOS_TRIGGERS=
MP_POP3_AUTH_FILE=
MP_POP3_TLS_CERT=
MP_POP3_TLS_KEY=
MP_TAG=
MP_TAGS_CONFIG=
MP_TAGS_TITLE_CASE=false
MP_TAGS_DISABLE=
MP_TAGS_USERNAME=false
MP_ENABLE_PROMETHEUS=false
MP_WEBHOOK_URL=
MP_WEBHOOK_LIMIT=1
MP_WEBHOOK_DELAY=0
