# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Postgres
POSTGRES_DB=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=your_strong_password

# Secret key (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# RabbitMQ
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=your_strong_password
RABBITMQ_VHOST=plane

# MinIO (S3-compatible file storage)
MINIO_ROOT_USER=plane-minio
MINIO_ROOT_PASSWORD=your_strong_password

# Caddy proxy listen address — must be set or the Caddyfile site block collapses to a keyless block
SITE_ADDRESS=:80

# Remaining Plane env vars (image defaults — not previously set, no behavior change)
PGDATA=/var/lib/postgresql/data
AWS_REGION=
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
API_KEY_RATE_LIMIT=60/minute
TRUSTED_PROXIES=0.0.0.0/0

# Database host/port. Default: this stack's shared server. Point at a managed
# database (AWS RDS, Azure Flexible Server, GCP Cloud SQL...) to move it out; homeserver.py
# then stops managing it here (docs/10-new-services.md "Managed-cloud parity").
DB_HOST=shared-postgres
DB_PORT=5432

# Backing-service endpoints (database, cache, queue, storage). Defaults are this
# stack's own containers; point them at managed services (AWS/Azure/GCP) to move
# a tier out without touching compose. See docs/10-new-services.md "Managed-cloud parity".
CACHE_HOST=plane-redis
CACHE_PORT=6379
MQ_HOST=plane-mq
S3_ENDPOINT=http://plane-minio:9000

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Plane — Storage paths
DATA_ROOT=../../service_data/data/plane

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret plane-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
