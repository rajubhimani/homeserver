# Plausible — Postgres
POSTGRES_PASSWORD=your_strong_password

# ClickHouse — network access for the default user is disabled by the
# official image unless a user/password is set explicitly
CLICKHOUSE_PASSWORD=your_strong_password

# App secrets — must be the literal base64 OUTPUT of these commands, not a
# hex string of the same visual length (TOTP_VAULT_KEY strictly requires
# base64-encoded 32 raw bytes; a 32-character hex string decodes to only 16
# bytes and Plausible refuses to boot):
#   openssl rand -base64 64   -> SECRET_KEY_BASE
#   openssl rand -base64 32   -> TOTP_VAULT_KEY
SECRET_KEY_BASE=your_random_secret
TOTP_VAULT_KEY=your_random_totp_key

# Registration — invite_only (default) means only the first account can
# self-register; everyone after that needs an invite from inside the app.
# Set to "true" to fully disable registration, "false" to leave it fully open.
DISABLE_REGISTRATION=invite_only

# Remaining Plausible env vars (image defaults — not previously set, no behavior change)
ENABLE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAXMIND_LICENSE_KEY=
MAXMIND_EDITION=GeoLite2-City
MAILER_ADAPTER=Bamboo.Mua
MAILER_EMAIL=plausible@example.com
MAILER_NAME=Plausible
# SMTP_HOST_ADDR/PORT below are actively set (unlike the rest of this
# "remaining vars" block) — point at Mailpit (this stack's SMTP test-catcher,
# services/mailpit/) for testing; no real mail delivery.
SMTP_HOST_ADDR=mailpit
SMTP_HOST_PORT=1025
SMTP_HOST_SSL_ENABLED=false
POSTMARK_API_KEY=
MAILGUN_API_KEY=
MAILGUN_BASE_URI=https://api.mailgun.net/v3
MANDRILL_API_KEY=
SENDGRID_API_KEY=
