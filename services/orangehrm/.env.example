# OrangeHRM — no DATA_ROOT yet: the app container has no persistent volume
# mount (see docs/services/orangehrm.md for why — a guessed path risked
# overlaying baked-in app files). All app state is currently ephemeral.

# MariaDB — on the shared server (shared-mariadb, 11.8 LTS; OrangeHRM's
# installer requires MariaDB >5 and <12). homeserver.py creates this database
# and user there; enter them in the web installer with host shared-mariadb.
MYSQL_DATABASE=orangehrm
MYSQL_USER=orangehrm
MYSQL_PASSWORD=your_strong_password

# No self-registration — HR admin creates employee accounts from inside the
# app after setup. No env var toggle exists for this.

# Possible remaining OrangeHRM env vars — UNVERIFIED. Sources conflict on
# whether the orangehrm/orangehrm image actually reads these (this stack's
# own setup wires the DB via the web installer instead, per
# docs/services/orangehrm.md, since that was the confirmed-working path).
# Left here commented out rather than presented as confirmed:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# PUID=1000
# PGID=1000
