# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Path to your media (movies, TV shows, music)
MEDIA_ROOT=/mnt/seagate/media

# Downloaded poster/fanart/NFO metadata cache — deliberately kept OUTSIDE
# service_data/data/jellyfin/ (a sibling under service_data/cache/ instead) so
# it's never swept into a backup/snapshot tar. Fully regenerable: deleting it
# just re-downloads from metadata providers on next scan. See
# docs/services/jellyfin.md for the incident that prompted this.
METADATA_ROOT=../../service_data/cache/jellyfin/metadata

# Tuning applied by apply-tuning.py — see docs/services/jellyfin.md for why
# each of these values. All have defaults baked into the script if unset here.

# Scan/trickplay concurrency — leave unset to default to the host's CPU core
# count. Only raise this if MEDIA_ROOT is local/direct-attached storage; high
# concurrency is hard on network shares (SMB/NFS).
# JELLYFIN_SCAN_CONCURRENCY=8

# SQLite locking mode (NoLock/Optimistic/Pessimistic) — fixes "database is
# locked" errors during large scans. Optimistic is the recommended first step.
# JELLYFIN_LOCKING_BEHAVIOR=Optimistic

# Embedded-image-extraction timeout in ms — Jellyfin's ~10s default is tight
# for CPU-decoded HEVC/10-bit content, especially under scan concurrency.
# JELLYFIN_IMAGE_EXTRACTION_TIMEOUT_MS=30000

# Trickplay thumbnail generation process priority
# (Idle/BelowNormal/Normal/AboveNormal/High/RealTime — full .NET ProcessPriorityClass set)
# JELLYFIN_TRICKPLAY_PROCESS_PRIORITY=Normal

# Save uploaded/downloaded subtitles next to the video (true) or under
# /config/metadata (false). compose.yml mounts MEDIA_ROOT read-only, so true
# makes subtitle uploads fail with "Read-only file system" — only set true if
# you also change that mount to :rw. Applied to every library by apply-tuning.py;
# re-run it after adding a library (new libraries default to true).
# JELLYFIN_SAVE_SUBTITLES_WITH_MEDIA=false

# Remaining Jellyfin env vars (image defaults — not previously set, no behavior change)
JELLYFIN_DATA_DIR=/config
JELLYFIN_CACHE_DIR=/cache
JELLYFIN_CONFIG_DIR=/config/config
JELLYFIN_LOG_DIR=/config/log
TZ=Etc/UTC

# Proxies whose X-Forwarded-For Jellyfin trusts for the visitor's IP
# (network.xml KnownProxies, written by apply-tuning.py): Docker's bridge
# networks (nginx-plain) and the Kubernetes pod network. IPs or CIDRs.
JELLYFIN_KNOWN_PROXIES=172.16.0.0/12,10.0.0.0/8

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Jellyfin — Storage paths
DATA_ROOT=../../service_data/data/jellyfin

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret jellyfin-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
