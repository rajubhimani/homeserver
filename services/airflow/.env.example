# Airflow — Storage paths
DATA_ROOT=../../service_data/data/airflow

# Postgres
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_strong_password

# Image tag — pin explicitly, check https://hub.docker.com/r/apache/airflow/tags for updates
AIRFLOW_VERSION=3.3.1

# Fernet key encrypts connection passwords/variables at rest in the metadata
# DB — must be a 32-byte urlsafe-base64 string. Generate a new one with:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Rotating this after DAGs/connections exist makes existing encrypted values unreadable.
FERNET_KEY=your_fernet_key_here

# JWT secret used for internal auth between scheduler/triggerer/dag-processor
# and the api-server's execution API. Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Web UI session/CSRF secret (AIRFLOW__API__SECRET_KEY). Generate: openssl rand -hex 32
API_SECRET_KEY=your_api_secret_key_here

# Admin account, created once by airflow-init on first start
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=your_strong_password
_AIRFLOW_WWW_USER_EMAIL=admin@example.com

# Host UID container processes run as — matters for who owns files under
# DATA_ROOT/dags,logs,config,plugins on the host. Image default (50000) is
# fine unless you want to directly edit DAG files as your own host user.
AIRFLOW_UID=50000

# GID that owns the host's Docker socket — lets airflow-scheduler (UID 50000,
# not root) join that group and use DockerOperator without the socket
# permission error documented in compose.yml. Differs per host/distro, so
# there's no safe default to ship here; look it up once:
#   stat -c '%g' /var/run/docker.sock
# (or the equivalent path if you set a custom DOCKER_SOCKET in the root .env)
DOCKER_SOCKET_GID=your_docker_socket_gid_here

# Ship with the example DAGs (good for a first look, noisy afterward)
LOAD_EXAMPLES=false

# Expose Admin -> Configuration in the UI (403s otherwise). "True" still
# masks sensitive values (passwords/secrets/keys) automatically.
AIRFLOW_EXPOSE_CONFIG=False

# SMTP target for task retry/failure alerting — defaults to the bundled
# Mailpit catcher (container name below), nothing leaves this host. Point
# at a real relay instead if you want actual delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=airflow@homeserver.local

# Airflow's full config surface is hundreds of AIRFLOW__<SECTION>__<KEY> vars
# (https://airflow.apache.org/docs/apache-airflow/stable/configurations-ref.html)
# — too large to usefully enumerate in full. The most-used/meaningful ones
# for a homelab-scale install are below (image defaults, verified against
# this stack's own running containers via `airflow config get-value` — not
# previously set, no behavior change). Add any other AIRFLOW__SECTION__KEY
# line here (and to .env) only for a setting you're actually overriding.

# How much runs at once — the two you'd actually hit a ceiling on first.
AIRFLOW__CORE__PARALLELISM=32
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=16

# UI/logs show UTC by default — set to your own tz (e.g. "America/Chicago")
# to see execution dates/logs in local time instead.
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc

# How long a single DAG *file* is given to finish parsing before it's
# treated as broken — matters if a DAG does something slow at import time.
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=30.0

# Retry defaults for any task that doesn't set its own (see
# example_scheduled_with_retries.py for setting these per-DAG instead).
AIRFLOW__CORE__DEFAULT_TASK_RETRIES=0
AIRFLOW__CORE__DEFAULT_TASK_RETRY_DELAY=300

# How often (seconds) the dag-processor rescans the dags folder for
# new/changed files — this is *why* dropping a new DAG in needs no restart.
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=300

AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Email alerts on task retry/failure — actually wired up (not just left at
# image defaults): AIRFLOW__SMTP__* in compose.yml points airflow-scheduler
# at the bundled Mailpit catcher (container airflow-mailpit, web UI on
# :8140) instead of the unreachable "localhost:25" default, so this
# genuinely sends mail instead of silently no-op'ing. Nothing leaves this
# host. See example_email_alert_on_failure.py.
AIRFLOW__EMAIL__DEFAULT_EMAIL_ON_RETRY=True
AIRFLOW__EMAIL__DEFAULT_EMAIL_ON_FAILURE=True

# Custom text in the UI's title bar/browser tab — useful once you're running
# more than one Airflow instance and need to tell them apart at a glance.
AIRFLOW__API__INSTANCE_NAME=
