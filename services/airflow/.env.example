# Airflow — Storage paths
DATA_ROOT=../../service_data/data/airflow

# Postgres
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_strong_password

# Image tag — pin explicitly, check https://hub.docker.com/r/apache/airflow/tags for updates
AIRFLOW_VERSION=3.3.1

# Fernet key encrypts connection passwords/variables at rest in the metadata
# DB — must be a 32-byte urlsafe-base64 string. Generate a new one with:
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Rotating this after DAGs/connections exist makes existing encrypted values unreadable.
FERNET_KEY=your_fernet_key_here

# JWT secret used for internal auth between scheduler/triggerer/dag-processor
# and the api-server's execution API. Generate: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Web UI session/CSRF secret (AIRFLOW__API__SECRET_KEY). Generate: openssl rand -hex 32
API_SECRET_KEY=your_api_secret_key_here

# Admin account, created once by airflow-init on first start
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=your_strong_password
_AIRFLOW_WWW_USER_EMAIL=admin@example.com

# Host UID container processes run as — matters for who owns files under
# DATA_ROOT/dags,logs,config,plugins on the host. Image default (50000) is
# fine unless you want to directly edit DAG files as your own host user.
AIRFLOW_UID=50000

# Ship with the example DAGs (good for a first look, noisy afterward)
LOAD_EXAMPLES=false

# Airflow's full config surface is hundreds of AIRFLOW__<SECTION>__<KEY> vars
# (https://airflow.apache.org/docs/apache-airflow/stable/configurations-ref.html)
# — too large to usefully enumerate here the way other services' .env.example
# files do. Everything not set above/in compose.yml is at the image default;
# add an AIRFLOW__SECTION__KEY=value line here (and to .env) only for a
# setting you're actually overriding.
