# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Postgres (with pgvector extension)
POSTGRES_USER=appflowy
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=appflowy

# JWT secret — shared between GoTrue and AppFlowy Cloud (min 32 chars)
# Generate: openssl rand -hex 32
GOTRUE_JWT_SECRET=your_jwt_secret_here

# MinIO (S3-compatible file storage)
MINIO_ROOT_USER=appflowy-minio
MINIO_ROOT_PASSWORD=your_strong_minio_password

# Email (optional — leave blank to skip email verification)
# When blank, GOTRUE_MAILER_AUTOCONFIRM=true is used (no email required).
# AUTOCONFIRM left as-is (signup behavior, out of scope for just wiring
# SMTP) — but the SMTP host below now points at Mailpit (services/mailpit/,
# container "mailpit") for testing, so any email GoTrue does send (password
# reset, invites) actually goes somewhere instead of failing against a blank
# host. Port 1025, not 465 — Mailpit has no TLS support, 465 is implicit-TLS.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_HOST=mailpit
GOTRUE_SMTP_PORT=1025
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_SENDER_NAME=AppFlowy

# Remaining AppFlowy env vars (image defaults — not previously set, no behavior change)
APPFLOWY_ACCESS_CONTROL=true
APPFLOWY_DATABASE_MAX_CONNECTIONS=40
APPFLOWY_WEBSOCKET_MAILBOX_SIZE=6000
APPFLOWY_S3_CREATE_BUCKET=true
RUST_LOG=info

# Backing-service endpoints (database, cache, queue, storage). Defaults are this
# stack's own containers; point them at managed services (AWS/Azure/GCP) to move
# a tier out without touching compose. See docs/10-new-services.md "Managed-cloud parity".
DB_HOST=appflowy-db
DB_PORT=5432
CACHE_HOST=appflowy-redis
CACHE_PORT=6379
S3_ENDPOINT=http://appflowy-minio:9000

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# AppFlowy Cloud — Notion-like collaborative workspace
DATA_ROOT=../../service_data/data/appflowy

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret appflowy-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
