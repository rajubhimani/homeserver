# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Remaining NPM env vars (image defaults — not previously set, no behavior change)
DB_SQLITE_FILE=/data/database.sqlite
DISABLE_IPV6=false
X_FRAME_OPTIONS=deny
IP_RANGES_FETCH_ENABLED=true

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Nginx Proxy Manager — Storage paths
DATA_ROOT=../../service_data/data/nginx

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret nginx-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
