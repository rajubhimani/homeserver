# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# This host's LAN IP — DNS (port 53) binds here specifically instead of
# 0.0.0.0, because on Linux hosts systemd-resolved's stub listener already
# holds 53 on 127.0.0.53/127.0.0.54, and a wildcard 0.0.0.0 bind conflicts
# with that. Binding to the LAN IP directly avoids the conflict without
# touching the host's own DNS resolution. Get it with `ip -4 addr` (the
# non-127.0.0.1, non-172.1[7-9]/172.2x/172.3[01].* docker-bridge address).
# If this host's IP changes (DHCP lease renewal), update this and restart —
# a DHCP reservation on your router avoids that.
DNS_BIND_IP=192.168.1.7

# No other required env vars — all remaining configuration (DNS upstreams,
# filter lists, admin password) is set through the first-run web setup
# wizard and stored in conf/AdGuardHome.yaml, not env vars.

# adguard-watchdog: reattaches adguard-home to the homeserver network if its
# Docker network attachment silently drops (see docs/services/adguard-home.md).
# Uncomment to override the defaults (60s interval, 2 consecutive failures
# before reattaching, 60s cooldown after a repair before checks resume).
# WATCHDOG_CHECK_INTERVAL=60
# WATCHDOG_FAIL_THRESHOLD=2
# WATCHDOG_RESTART_COOLDOWN=60

# adguard-watchdog pushes an ntfy alert every time it has to repair the
# network attachment, so a repair is never silent. Same values as in
# services/ntfy/.env (the canonical copy).
NTFY_ALERT_URL=http://ntfy/homeserver-alerts
NTFY_ALERT_TOKEN=your_ntfy_access_token

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# AdGuard Home — Storage paths
DATA_ROOT=../../service_data/data/adguard-home

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret adguard-home-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
