# Open WebUI — Storage paths
DATA_ROOT=../../service_data/data/open-webui

# Embedding model cache — lives outside service_data/data/ so it's never
# swept into the config-only backup snapshot. Grouped under service_data/cache/
# alongside other services' regenerable caches (see jellyfin's METADATA_ROOT
# for the same convention). Fully regenerable: deleting it just re-downloads
# the embedding model on next use.
MODELS_ROOT=../../service_data/cache/open-webui/cache

# Image variant — slim (default, CPU setup) has no bundled local RAG/embeddings/
# Whisper/TTS stack. Switch to v0.11.0 (standard, no -slim suffix) when GPU
# passthrough lands and local RAG/voice features are wanted, then run
# `uv run homeserver.py dev update open-webui` to pull and recreate. Chat
# history/settings are untouched — see docs/services/open-webui.md.
OPEN_WEBUI_IMAGE_TAG=v0.11.0-slim

# Ollama backend — defaults to a native/host-installed Ollama (host.docker.internal
# resolves via the host-gateway extra_hosts entry in compose.yml on Linux, Mac, and
# Windows). The host Ollama must be started with OLLAMA_HOST=0.0.0.0 so it accepts
# connections from the container network.
#
# To use the containerized ollama service instead, start it with
# `uv run homeserver.py dev up ollama open-webui --profile docker-ollama`
# and change this to OLLAMA_BASE_URL=http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Registration — set to false to disable, true to allow
ENABLE_SIGNUP=false

WEBUI_SECRET_KEY=change_me_to_a_random_string

# Remaining Open WebUI env vars (image defaults — not previously set, no behavior change)
WEBUI_NAME=Open WebUI
WEBUI_AUTH=true
DEFAULT_LOCALE=en
ENABLE_OLLAMA_API=true
ENABLE_OPENAI_API=true
ENABLE_COMMUNITY_SHARING=true
ENABLE_MESSAGE_RATING=true
CORS_ALLOW_ORIGIN=*
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
