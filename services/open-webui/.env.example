# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Embedding model cache — lives outside service_data/data/ so it's never
# swept into the config-only backup snapshot. Grouped under service_data/cache/
# alongside other services' regenerable caches (see jellyfin's METADATA_ROOT
# for the same convention). Fully regenerable: deleting it just re-downloads
# the embedding model on next use.
MODELS_ROOT=../../service_data/cache/open-webui/cache

# Image variant — slim (default, CPU setup) has no bundled local RAG/embeddings/
# Whisper/TTS stack. Switch to v0.11.0 (standard, no -slim suffix) when GPU
# passthrough lands and local RAG/voice features are wanted, then run
# `uv run homeserver.py dev update open-webui` to pull and recreate. Chat
# history/settings are untouched — see docs/services/open-webui.md.
OPEN_WEBUI_IMAGE_TAG=v0.12.3-slim

# Ollama backend — defaults to a native/host-installed Ollama (host.docker.internal
# resolves via the host-gateway extra_hosts entry in compose.yml on Linux, Mac, and
# Windows). The host Ollama must be started with OLLAMA_HOST=0.0.0.0 so it accepts
# connections from the container network.
#
# To use the containerized ollama service instead, start it with
# `uv run homeserver.py dev up ollama open-webui --profile docker-ollama`
# and change this to OLLAMA_BASE_URL=http://ollama:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ────────────────────────────────────────────────────────────
# Open Terminal — code-execution sandbox started with Open WebUI (docs/services/open-terminal.md).
# Open WebUI's backend reaches it over the internal network (never exposed publicly) with this
# key; compose.yml turns OPEN_TERMINAL_URL + OPEN_TERMINAL_API_KEY into TERMINAL_SERVER_CONNECTIONS.
# A value already saved in Open WebUI's database wins over this one, so see
# docs/services/open-terminal.md if the terminal does not show up in chats.
# Generate a key: python3 -c "import secrets;print(secrets.token_hex(32))"
# ────────────────────────────────────────────────────────────
OPEN_TERMINAL_URL=http://open-terminal:8000
OPEN_TERMINAL_API_KEY=change-me

# Image tag — no LTS track, so the newest release. Keep the default (full) image: the
# slim/alpine variants ignore the package variables below.
OPEN_TERMINAL_IMAGE_TAG=0.14.1

# Resource caps for the sandbox (upstream's security guide recommends them; its example uses 2g / 2 cpus,
# raised here because PyTorch/xgboost work needs more).
OPEN_TERMINAL_MEMORY_LIMIT=8G
OPEN_TERMINAL_CPUS=4

# Libraries installed at every terminal start, grouped by use: ML/DL (CPU-only PyTorch via the
# extra index, transformers, onnxruntime, xgboost, lightgbm, optuna, shap), data (polars, duckdb + CLI,
# pyarrow), scraping (httpx, scrapy, trafilatura), APIs and databases (fastapi, sqlalchemy, alembic), pipelines (pydantic, tenacity), documents
# (pdfplumber, pymupdf, reportlab, markitdown, OCR via tesseract-ocr). Already in the image: numpy,
# pandas, scipy, scikit-learn, matplotlib, seaborn, plotly, requests, beautifulsoup4, lxml,
# sqlalchemy, openpyxl, python-docx, python-pptx, pypdf, jupyter. Space-separated; pip installs
# persist in the home directory, so restarts only re-check them. Add whatever you need.
OPEN_TERMINAL_PIP_PACKAGES=--extra-index-url https://download.pytorch.org/whl/cpu torch torchvision torchaudio transformers sentence-transformers onnxruntime xgboost lightgbm optuna shap imbalanced-learn statsmodels polars duckdb duckdb-cli pyarrow xlsxwriter sympy networkx fastapi uvicorn sqlalchemy alembic pydantic tenacity python-dotenv httpx scrapy trafilatura html5lib feedparser pdfplumber pymupdf reportlab markitdown docx2txt pytesseract pdf2image pillow opencv-python-headless pytest ruff
OPEN_TERMINAL_PACKAGES=tesseract-ocr
OPEN_TERMINAL_NPM_PACKAGES=

# Remaining Open Terminal env vars (image defaults — not previously set, no behavior change)
OPEN_TERMINAL_CORS_ALLOWED_ORIGINS=*
OPEN_TERMINAL_MAX_SESSIONS=16
OPEN_TERMINAL_ENABLE_TERMINAL=true
OPEN_TERMINAL_ENABLE_NOTEBOOKS=true
OPEN_TERMINAL_ENABLE_SYSTEM_PROMPT=true
OPEN_TERMINAL_MULTI_USER=false
OPEN_TERMINAL_TERM=xterm-256color
OPEN_TERMINAL_MAX_LOG_SIZE=50000000
OPEN_TERMINAL_LOG_RETENTION=604800
OPEN_TERMINAL_LOG_FLUSH_INTERVAL=0
OPEN_TERMINAL_LOG_FLUSH_BUFFER=0
OPEN_TERMINAL_BINARY_MIME_PREFIXES=image
OPEN_TERMINAL_FILE_BROWSER_ROOT=home
OPEN_TERMINAL_SESSION_CWD_TTL=604800

# Registration — set to false to disable, true to allow
ENABLE_SIGNUP=false

WEBUI_SECRET_KEY=change_me_to_a_random_string

# Remaining Open WebUI env vars (image defaults — not previously set, no behavior change)
WEBUI_NAME=Open WebUI
WEBUI_AUTH=true
DEFAULT_LOCALE=en
ENABLE_OLLAMA_API=true
ENABLE_OPENAI_API=true
ENABLE_COMMUNITY_SHARING=true
ENABLE_MESSAGE_RATING=true
CORS_ALLOW_ORIGIN=*
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true

# Open Terminal home directory (workspace + pip/npm installs, can reach several GB): scratch space
# in the cache bucket, outside service_data/data/ so snapshots skip it. Deleting it only costs a re-install.
TERMINAL_HOME_ROOT=../../service_data/cache/open-webui/terminal-home

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Open WebUI — Storage paths
DATA_ROOT=../../service_data/data/open-webui

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret open-webui-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
