# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Admin token (generate with: openssl rand -base64 48)
ADMIN_TOKEN=your_admin_token_here

# Registration — set to false to disable, true to allow
SIGNUPS_ALLOWED=false

# SMTP (invite/2FA emails) — points at Mailpit (this stack's SMTP
# test-catcher, services/mailpit/) for testing; no real mail delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=off
SMTP_FROM=vaultwarden@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Remaining Vaultwarden env vars (image defaults — not previously set, no behavior change)
WEB_VAULT_ENABLED=true
ENABLE_WEBSOCKET=true
SENDS_ALLOWED=true
LOG_LEVEL=info
# The visitor's IP for logs and login rate limiting. CF-Connecting-IP is set
# by Cloudflare itself, so a visitor can't fake it through the tunnel; it
# reaches Vaultwarden under Docker (nginx-plain) and Kubernetes (Traefik)
# alike. Not X-Real-IP (Traefik doesn't carry it; see docs/services/
# vaultwarden.md) and not X-Forwarded-For (Vaultwarden takes its first
# entry, which a visitor can fake). Without the header (LAN access) it uses
# the connection's own address.
IP_HEADER=CF-Connecting-IP

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Vaultwarden — Storage paths
DATA_ROOT=../../service_data/data/vaultwarden

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret vaultwarden-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
