DATA_ROOT=../../service_data/data/dockge

# Directory where Dockge stores and manages compose stacks.
#
# IMPORTANT: Dockge runs `docker compose` commands using the HOST path, so the
# path must be identical inside and outside the container. This means:
#   - Must be an absolute path (no relative paths like ../data/stacks)
#   - The same value is used on both sides of the volume mount
#   - Create the directory before starting: mkdir -p <this path>
#
# Use a path already shared with Docker (e.g. under /mnt/docker-data).
#
# Deliberately kept OUTSIDE service_data/data/dockge/ (a sibling under
# service_data/stacks/ instead) so `homeserver.py`'s backup_service() — which
# tars the whole DATA_ROOT dir — never sweeps managed stack data into a
# snapshot. Same convention as jellyfin's MEDIA_ROOT / immich's
# UPLOAD_LOCATION — see docs/services/jellyfin.md for the incident that
# prompted it.
DOCKGE_STACKS_DIR=/absolute/path/to/homeserver/service_data/stacks/dockge
