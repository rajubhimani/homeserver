# Authentik — Storage paths
DATA_ROOT=../../service_data/data/authentik

# Postgres
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=your_strong_password

# Secret key (generate with: openssl rand -base64 60)
AUTHENTIK_SECRET_KEY=your_secret_key_here

# Remaining authentik env vars (image defaults — not previously set, no behavior change)
AUTHENTIK_LOG_LEVEL=info
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_AVATARS=gravatar,initials
AUTHENTIK_DEFAULT_USER_CHANGE_NAME=true
AUTHENTIK_DEFAULT_USER_CHANGE_EMAIL=false
AUTHENTIK_DEFAULT_USER_CHANGE_USERNAME=false
AUTHENTIK_GDPR_COMPLIANCE=true
AUTHENTIK_DEFAULT_TOKEN_LENGTH=60
AUTHENTIK_DISABLE_UPDATE_CHECK=false
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=false
