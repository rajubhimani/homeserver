# Paperless-ngx — Storage paths
DATA_ROOT=../../service_data/data/paperless

# Timezone
TZ=Asia/Kolkata

# Postgres
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=your_strong_password

# Secret key (generate with: openssl rand -hex 32)
PAPERLESS_SECRET_KEY=your_hex_secret_here


# Admin account (created on first start)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=your_strong_password

# Resource limits — reduce memory footprint
PAPERLESS_TASK_WORKERS=1
PAPERLESS_THREADS_PER_WORKER=1

# Remaining Paperless-ngx env vars (image defaults — not previously set, no behavior change)
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_MODE=skip
PAPERLESS_OCR_OUTPUT_TYPE=pdfa
PAPERLESS_CONSUMER_POLLING=0
PAPERLESS_CONSUMER_RECURSIVE=false
PAPERLESS_WEBSERVER_WORKERS=1
PAPERLESS_ENABLE_NLTK=true
PAPERLESS_ENABLE_COMPRESSION=true
PAPERLESS_EMPTY_TRASH_DELAY=30
PAPERLESS_APP_TITLE=Paperless-ngx
PAPERLESS_DATE_ORDER=DMY
