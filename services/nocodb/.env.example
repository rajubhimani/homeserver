# NocoDB — Storage paths
DATA_ROOT=../../service_data/data/nocodb

# Postgres
POSTGRES_DB=nocodb
POSTGRES_USER=nocodb
POSTGRES_PASSWORD=your_strong_password

# First account created through the UI becomes admin — no separate
# registration toggle exists to set here (invite-based after first account).

# JWT signing secret — if unset, NocoDB generates a random one on every
# restart, silently invalidating every active session. Generate with:
#   openssl rand -hex 24
NC_AUTH_JWT_SECRET=your_random_secret

# Remaining NocoDB env vars (image defaults — not previously set, no behavior change)
NC_JWT_EXPIRES_IN=10h
DB_QUERY_LIMIT_DEFAULT=25
DB_QUERY_LIMIT_MAX=1000
NC_REQUEST_BODY_SIZE=1048576
NC_DISABLE_TELE=
NC_DISABLE_ERR_REPORTS=
NC_DISABLE_CACHE=false
NC_ATTACHMENT_FIELD_SIZE=20971520
NC_DISABLE_AUDIT=false
NC_AUTOMATION_LOG_LEVEL=OFF
NC_ADMIN_EMAIL=
NC_ADMIN_PASSWORD=
NC_SMTP_FROM=
NC_SMTP_HOST=
NC_SMTP_PORT=
NC_SMTP_USERNAME=
NC_SMTP_PASSWORD=
NC_SMTP_SECURE=false
