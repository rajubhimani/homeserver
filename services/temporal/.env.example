# Temporal — Storage paths
DATA_ROOT=../../service_data/data/temporal

# Postgres
POSTGRES_DB=temporal
POSTGRES_USER=temporal
POSTGRES_PASSWORD=your_strong_password

# Image tags — pin explicitly. Check for updates:
#   https://hub.docker.com/r/temporalio/server/tags
#   https://hub.docker.com/r/temporalio/admin-tools/tags
#   https://hub.docker.com/r/temporalio/ui/tags
TEMPORAL_VERSION=1.29.1
TEMPORAL_ADMINTOOLS_VERSION=1.29.1-tctl-1.18.4-cli-1.5.0
TEMPORAL_UI_VERSION=2.34.0

# Remaining temporalio/server env vars (image defaults — not previously set,
# no behavior change). Verified directly against this image's own
# /etc/temporal/config/config_template.yaml, not just docs — the full
# template also covers Cassandra/MySQL backends and internode/frontend mTLS,
# neither relevant to this single-node Postgres deployment, so left out here.
# NUM_HISTORY_SHARDS in particular can't be changed after first setup —
# worth knowing it exists before, not after.
LOG_LEVEL=info
NUM_HISTORY_SHARDS=4
PROMETHEUS_ENDPOINT=

# Remaining temporalio/ui env vars (image defaults — not previously set, no
# behavior change). Verified directly against this image's own
# /home/ui-server/config-template.yaml. TEMPORAL_AUTH_* is how you'd add
# real login to the UI — see docs/services/temporal.md's Notes on why
# there's none today.
TEMPORAL_DEFAULT_NAMESPACE=default
TEMPORAL_SHOW_TEMPORAL_SYSTEM_NAMESPACE=false
TEMPORAL_DISABLE_WRITE_ACTIONS=false
TEMPORAL_HIDE_LOGS=false
TEMPORAL_FEEDBACK_URL=
TEMPORAL_CODEC_ENDPOINT=
TEMPORAL_AUTH_ENABLED=false
TEMPORAL_AUTH_TYPE=oidc
TEMPORAL_AUTH_PROVIDER_URL=
TEMPORAL_AUTH_CLIENT_ID=
TEMPORAL_AUTH_CLIENT_SECRET=
TEMPORAL_AUTH_CALLBACK_URL=
