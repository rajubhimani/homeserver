# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Fixed ID of this KRaft cluster (22-char base64 UUID). Generate your own:
#   docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid
# Keep it forever: changing it against existing data makes the broker refuse to start.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
# Address clients OUTSIDE Docker use to reach the broker (the EXTERNAL
# listener, port 9092). Containers use kafka:19092 and ignore this.
# localhost = clients on this machine; set the server's LAN/WireGuard IP for others.
KAFKA_EXTERNAL_HOST=localhost
# true = producing to a new topic creates it (handy for experiments).
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
# How long messages are kept before deletion.
KAFKA_LOG_RETENTION_HOURS=168
# JVM heap; the broker's default is 1G.
KAFKA_HEAP_OPTS=-Xmx512M -Xms512M

# How other containers on the homeserver network reach the broker.
# Clients read this from THEIR OWN .env, never hardcode the host.
MQ_HOST=kafka
MQ_PORT=19092

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Data is the named volume kafka-data, not a bind mount.
DATA_ROOT=../../service_data/data/kafka

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret kafka-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
