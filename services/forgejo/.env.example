# Forgejo — Storage paths
DATA_ROOT=../../service_data/data/forgejo

# Postgres
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=your_strong_password

# Comma-separated Forgejo SPDX license template IDs shown first when creating a repo.
PREFERRED_LICENSES=Apache-2.0,GPL-3.0-only,MIT

# Registration — set to true to disable, false to allow
DISABLE_REGISTRATION=false

# Remaining Forgejo env vars (image defaults — not previously set, no behavior change)
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__PROTOCOL=http
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__service__REQUIRE_SIGNIN_VIEW=false
FORGEJO__actions__DEFAULT_ACTIONS_URL=https://github.com
FORGEJO__log__LEVEL=info

# Actions runner (optional, only used with --profile runner)
# Get a token from https://forgejo.<DOMAIN>/-/admin/actions/runners -> "Create new Runner"
RUNNER_REGISTRATION_TOKEN=
RUNNER_NAME=forgejo-runner
RUNNER_LABELS=docker:docker://node:20-bookworm
