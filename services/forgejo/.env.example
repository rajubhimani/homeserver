# Forgejo — Storage paths
DATA_ROOT=../../service_data/data/forgejo

# Postgres
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=your_strong_password

# Comma-separated Forgejo SPDX license template IDs shown first when creating a repo.
PREFERRED_LICENSES=Apache-2.0,GPL-3.0-only,MIT

# Registration — set to true to disable, false to allow
DISABLE_REGISTRATION=true

# Outgoing email — points at Mailpit (services/mailpit/, container "mailpit")
# for testing; no real mail delivery. No auth needed, so no
# FORGEJO__mailer__USER/PASSWD set.
FORGEJO__mailer__ENABLED=true
FORGEJO__mailer__PROTOCOL=smtp
FORGEJO__mailer__SMTP_ADDR=mailpit
FORGEJO__mailer__SMTP_PORT=1025
FORGEJO__mailer__FROM=forgejo@example.com

# Remaining Forgejo env vars (image defaults — not previously set, no behavior change)
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__PROTOCOL=http
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__service__REQUIRE_SIGNIN_VIEW=false
FORGEJO__actions__DEFAULT_ACTIONS_URL=https://github.com
FORGEJO__log__LEVEL=info
FORGEJO__actions__ENABLED=true

# forgejo-runner's own /data (registration file + actions/checkout cache).
# Deliberately an absolute path OUTSIDE service_data/ -- if service_data
# resolves to a FUSE-mounted filesystem (ntfs/exfat via ntfs-3g etc.), it
# reports every file as root-owned regardless of which UID actually wrote
# it, which makes act's checkout cache trip Git's "detected dubious
# ownership" check and fail every job at the checkout step -- confirmed
# live on this repo's own reference host, recurring immediately even on a
# freshly cleared cache (i.e. it's the mount, not stale state). Point this
# at a native Linux filesystem (ext4/xfs/btrfs) instead -- check with
# `findmnt -T <path>` (fstype should NOT be fuseblk/ntfs/exfat).
FORGEJO_RUNNER_DATA_ROOT=/home/YOUR_USER/forgejo-runner-data

# Actions runner (starts automatically with Forgejo)
# Get a token from https://forgejo.<DOMAIN>/-/admin/actions/runners -> "Create new Runner"
RUNNER_REGISTRATION_TOKEN=
RUNNER_NAME=forgejo-runner
RUNNER_LABELS=docker:docker://catthehacker/ubuntu:act-latest,ubuntu-latest:docker://catthehacker/ubuntu:act-latest,ubuntu-24.04:docker://catthehacker/ubuntu:act-24.04,ubuntu-22.04:docker://catthehacker/ubuntu:act-22.04

# How many jobs run concurrently -- 1 (default) is strictly sequential.
# Raising this trades more simultaneous CPU/memory/disk I/O for parallel
# jobs. Tried 4 on this repo's reference host: hit a real Forgejo
# server-side bug (500 from Forgejo's own UpdateTask API when two jobs'
# status updates land in the same instant) plus service containers with
# fixed host ports (e.g. postgres/redis on 5432/6379) colliding across
# concurrent jobs -- see the RUNNER_CAPACITY comment in compose.yml and
# docs/services/forgejo.md before raising it.
RUNNER_CAPACITY=1
