# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Postgres
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=your_strong_password

# Comma-separated Forgejo SPDX license template IDs shown first when creating a repo.
PREFERRED_LICENSES=Apache-2.0,GPL-3.0-only,MIT

# Registration — set to true to disable, false to allow
DISABLE_REGISTRATION=true

# Outgoing email — points at Mailpit (services/mailpit/, container "mailpit")
# for testing; no real mail delivery. No auth needed, so no
# FORGEJO__mailer__USER/PASSWD set.
FORGEJO__mailer__ENABLED=true
FORGEJO__mailer__PROTOCOL=smtp
FORGEJO__mailer__SMTP_ADDR=mailpit
FORGEJO__mailer__SMTP_PORT=1025
FORGEJO__mailer__FROM=forgejo@example.com

# Remaining Forgejo env vars (image defaults — not previously set, no behavior change)
FORGEJO__server__HTTP_PORT=3000
FORGEJO__server__PROTOCOL=http
FORGEJO__repository__DEFAULT_BRANCH=main
FORGEJO__service__REQUIRE_SIGNIN_VIEW=false
FORGEJO__actions__DEFAULT_ACTIONS_URL=https://github.com
FORGEJO__log__LEVEL=info
FORGEJO__actions__ENABLED=true

# forgejo-runner's own /data (registration file + actions/checkout cache).
# Not auto-injected like DATA_ROOT (see CLAUDE.md's "second, independent
# service_data/-pointing env var" note), so this must be an absolute path --
# point it at service_data/data/forgejo/runner-data on THIS host so
# everything forgejo-related stays under one folder, same as any other
# service's data. The one thing that must hold for this to be safe: check
# `findmnt -T <path to your service_data>` and confirm the fstype is NOT
# fuseblk/ntfs/exfat. If it is, a FUSE mount reports every file as
# root-owned regardless of which UID actually wrote it, which makes act's
# checkout cache trip Git's "detected dubious ownership" check and fail
# every job at the checkout step -- confirmed live on this repo's own
# reference host at an earlier point when service_data did resolve to a
# FUSE mount, recurring immediately even on a freshly cleared cache (i.e.
# it's the mount, not stale state). If your service_data does turn out to
# be FUSE-mounted, point this at any native Linux filesystem (ext4/xfs/btrfs)
# path outside service_data instead.
FORGEJO_RUNNER_DATA_ROOT=/path/to/homeserver/service_data/data/forgejo/runner-data

# Actions runner (starts automatically with Forgejo)
# Get UUID + Token from https://forgejo.<DOMAIN>/-/admin/actions/runners ->
# "Create new Runner" (v13+ generates a per-runner UUID+token pair for the
# server.connections config schema -- NOT the old reusable pool-token
# `register --token` flow, which this pin's runner deprecated).
RUNNER_UUID=
RUNNER_TOKEN=
RUNNER_LABELS=docker:docker://catthehacker/ubuntu:act-latest,ubuntu-latest:docker://catthehacker/ubuntu:act-latest,ubuntu-24.04:docker://catthehacker/ubuntu:act-24.04,ubuntu-22.04:docker://catthehacker/ubuntu:act-22.04

# How many jobs run concurrently -- 1 (default) is strictly sequential.
# Raising this trades more simultaneous CPU/memory/disk I/O for parallel
# jobs. Tried 4 on this repo's reference host: hit a real Forgejo
# server-side bug (500 from Forgejo's own UpdateTask API when two jobs'
# status updates land in the same instant) plus service containers with
# fixed host ports (e.g. postgres/redis on 5432/6379) colliding across
# concurrent jobs -- see the RUNNER_CAPACITY comment in compose.yml and
# docs/services/forgejo.md before raising it.
RUNNER_CAPACITY=1

# Backing-service endpoints (database, cache, queue, storage). Defaults are this
# stack's own containers; point them at managed services (AWS/Azure/GCP) to move
# a tier out without touching compose. See docs/10-new-services.md "Managed-cloud parity".
DB_HOST=forgejo-db
DB_PORT=5432

# Real client IPs: the proxies Forgejo trusts to report the visitor's address
# (X-Forwarded-For). Docker's bridge networks (nginx-plain) and the Kubernetes
# pod network (cloudflared, Traefik); loopback stays trusted. LIMIT=2 covers
# Kubernetes' two hops (tunnel, then Traefik); under Docker there's one.
REVERSE_PROXY_TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12,10.0.0.0/8
REVERSE_PROXY_LIMIT=2

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Forgejo — Storage paths
DATA_ROOT=../../service_data/data/forgejo

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret forgejo-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
