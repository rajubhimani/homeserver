# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Your domain — all service links on the landing page are built from this
DOMAIN=yourdomain.com

# Site identity
SITE_NAME=My Homeserver
TAGLINE=Your data, your hardware, your control.

# Footer
AUTHOR=Your Name
LOCATION=Your City, Country

# Plausible analytics script filename — from your self-hosted Plausible
# instance's site Settings -> Tracking -> Review "site installation" (see
# docs/services/plausible.md). Loaded from https://plausible.${DOMAIN}/js/.
# Leave blank to disable the analytics embed entirely.
PLAUSIBLE_SCRIPT=script.js

# Health-check proxying (nginx.conf): DNS resolver for the per-service
# upstreams. "auto" = this container's own nameserver (Docker's 127.0.0.11
# under Compose, kube-dns under Kubernetes). UPSTREAM_SUFFIX is appended to
# each upstream name: empty for Compose; Kubernetes sets it via
# kubernetes/overrides/landing.yaml.
NGINX_RESOLVER=auto

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
UPSTREAM_SUFFIX=

# wg-easy runs on the host network, so the status check reaches it by
# address, not by container name: the homeserver bridge's gateway under
# Compose. Kubernetes sets its Service (kubernetes/overrides/landing.yaml).
WG_EASY_HOST=172.18.0.1

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret landing-env, and kubernetes/generate.py sets what differs:
#   UPSTREAM_SUFFIX=.apps.svc.cluster.local
#   WG_EASY_HOST=wg-easy.apps.svc.cluster.local
