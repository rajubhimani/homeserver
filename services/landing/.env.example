# Your domain — all service links on the landing page are built from this
DOMAIN=yourdomain.com

# Site identity
SITE_NAME=My Homeserver
TAGLINE=Your data, your hardware, your control.

# Footer
AUTHOR=Your Name
LOCATION=Your City, Country

# Plausible analytics script filename — from your self-hosted Plausible
# instance's site Settings -> Tracking -> Review "site installation" (see
# docs/services/plausible.md). Loaded from https://plausible.${DOMAIN}/js/.
# Leave blank to disable the analytics embed entirely.
PLAUSIBLE_SCRIPT=script.js
