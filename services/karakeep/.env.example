# Karakeep — Storage paths
DATA_ROOT=../../service_data/data/karakeep

# Signs session cookies and protects the search index — generate long random strings
NEXTAUTH_SECRET=your_random_secret
MEILI_MASTER_KEY=your_random_secret

# Self-registration — set to true to close the instance to new signups after
# creating your own account
DISABLE_SIGNUPS=true

# Optional: enables AI auto-tagging of bookmarks. This stack already runs
# Ollama — point at it instead of paying for OpenAI:
#   OPENAI_BASE_URL=http://ollama:11434/v1
#   OPENAI_API_KEY=ollama
#   INFERENCE_TEXT_MODEL=llama3.1
#   INFERENCE_IMAGE_MODEL=llava
# OPENAI_API_KEY=

# Outgoing email (signup/password-reset verification) — points at Mailpit
# (this stack's SMTP test-catcher, services/mailpit/) for testing; no real
# mail delivery. No auth needed, no TLS (Mailpit doesn't support it).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=karakeep@example.com

# Remaining Karakeep env vars (image defaults — not previously set, no behavior change)
CRAWLER_NUM_WORKERS=1
INFERENCE_JOB_TIMEOUT_SEC=30
DISABLE_NEW_RELEASE_CHECK=false
