# Penpot — Storage paths
DATA_ROOT=../../service_data/data/penpot

# Postgres
POSTGRES_PASSWORD=your_strong_password

# Master secret key — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Losing/changing this invalidates every active session and pending invitation.
PENPOT_SECRET_KEY=your_random_secret

# Feature flags (space-separated, format: enable-<flag> / disable-<flag>).
# Self-registration is on by default; add "disable-registration" to close it
# once accounts exist ("disable-registration" is officially recommended for
# demo instances only, not necessarily hardened for production, but
# reasonable for a personal instance).
# SMTP below is inert until "enable-smtp" is added here too — Penpot gates
# SMTP on this flag, not a separate on/off env var (a real mix-up caught
# while backfilling this file: an earlier PENPOT_SMTP_ENABLED var here did
# nothing, since Penpot never reads it).
PENPOT_FLAGS=enable-smtp

# SMTP — points at Mailpit (this stack's SMTP test-catcher, services/mailpit/)
# for testing; no real mail delivery. Swap to a real provider for production.
PENPOT_SMTP_HOST=mailpit
PENPOT_SMTP_PORT=1025
PENPOT_SMTP_USERNAME=
PENPOT_SMTP_PASSWORD=

# Remaining Penpot env vars (image defaults — not previously set, no behavior change)
PENPOT_SMTP_DEFAULT_REPLY_TO=Penpot <no-reply@example.com>
PENPOT_SMTP_DEFAULT_FROM=Penpot <no-reply@example.com>
PENPOT_SMTP_TLS=false
PENPOT_REGISTRATION_DOMAIN_WHITELIST=
PENPOT_OBJECTS_STORAGE_BACKEND=fs
PENPOT_FILE_DATA_BACKEND=legacy-db
PENPOT_AUTO_FILE_SNAPSHOT_EVERY=5
PENPOT_AUTO_FILE_SNAPSHOT_TIIMEOUT=1h
PENPOT_IMAGEMAGICK_THREAD_LIMIT=2
PENPOT_IMAGEMAGICK_MEMORY_LIMIT=256MiB
PENPOT_IMAGEMAGICK_MAP_LIMIT=512MiB
PENPOT_IMAGEMAGICK_AREA_LIMIT=128MP
PENPOT_IMAGEMAGICK_DISK_LIMIT=1GiB
PENPOT_IMAGEMAGICK_TIME_LIMIT=30
