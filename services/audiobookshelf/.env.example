# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Timezone
TZ=Asia/Kolkata

# Remaining Audiobookshelf env vars (image defaults — not previously set, no behavior change)
PORT=80
CONFIG_PATH=/config
METADATA_PATH=/metadata

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Audiobookshelf — Storage paths
DATA_ROOT=../../service_data/data/audiobookshelf

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret audiobookshelf-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
