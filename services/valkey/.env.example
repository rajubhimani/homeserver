# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Password of the admin login ("default"), used by you and by homeserver.py to
# create the per-service logins. Never given to an app. Generate a real one
# (letters and digits only):
#   openssl rand -hex 24
# Editing it and restarting valkey rotates it.
VALKEY_PASSWORD=change_me
# RAM ceiling; at the limit the policy below decides what is evicted.
VALKEY_MAXMEMORY=256mb
# allkeys-lru = behave as a cache (evict any key). Use noeviction instead if
# you store data you can't lose (writes then fail at the limit).
VALKEY_MAXMEMORY_POLICY=allkeys-lru

# How other containers on the homeserver network reach this instance.
# Clients read these from THEIR OWN .env, never hardcode the host.
CACHE_HOST=valkey
CACHE_PORT=6379

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Data is the named volume valkey-data (AOF), not a bind mount.
DATA_ROOT=../../service_data/data/valkey

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret valkey-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
