# Docs — no data paths, no DB. Serves the repo's own setup.md + docs/ tree
# read-only, live (no build step, no copy) — edit a .md file on the host,
# refresh the browser, see the change immediately.

# Browser tab title / Docsify sidebar heading
SITE_TITLE=Homeserver Docs

# Needed here (unlike most services, where homeserver.py's DOMAIN injection
# only affects compose-file interpolation, not the container's runtime env)
# because entrypoint.sh sed-substitutes it directly into index.html for the
# Plausible analytics embed below (https://plausible.${DOMAIN}/js/...) —
# must match root .env's DOMAIN.
DOMAIN=yourdomain.com

# Plausible analytics script filename — from your self-hosted Plausible
# instance's site Settings -> Tracking -> Review "site installation" (see
# docs/services/plausible.md). Leave blank to disable the analytics embed.
PLAUSIBLE_SCRIPT=script.js
