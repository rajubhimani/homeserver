# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Secret used to sign/verify requests between Nextcloud and this Document
# Server (JWT). Must be entered verbatim as the "Secret key" in Nextcloud's
# Settings -> Administration -> ONLYOFFICE admin page, or the connector
# fails with a JWT/token error. Generate with: openssl rand -hex 32
JWT_SECRET=your_strong_jwt_secret

# Enables the Document Server's own bundled demo editor at /example/ — a
# sandbox with its own isolated storage, unrelated to Nextcloud/real files.
# Blocked on the public onlyoffice.${DOMAIN} route (see nginx-plain's
# default.conf.template) since it has no login of its own; only reachable
# via the internal dev port for admin testing. Set to false to disable the
# backing process entirely instead of just blocking the public route.
EXAMPLE_ENABLED=true

# Remaining ONLYOFFICE Document Server env vars (image defaults — not previously set, no behavior change)
JWT_ENABLED=true

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# ONLYOFFICE Document Server — storage paths
DATA_ROOT=../../service_data/data/onlyoffice

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret onlyoffice-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
