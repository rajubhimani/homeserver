# Documenso — Storage paths
DATA_ROOT=../../service_data/data/documenso

# Postgres
POSTGRES_DB=documenso
POSTGRES_USER=documenso
POSTGRES_PASSWORD=your_strong_password

# App secrets — generate with: openssl rand -base64 32 (each must be 32+ chars)
NEXTAUTH_SECRET=your_random_secret
NEXT_PRIVATE_ENCRYPTION_KEY=your_random_32char_key
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=your_random_32char_key

# Document-signing certificate — REQUIRED, the container won't start without
# a valid cert.p12 at service_data/data/documenso/cert.p12. Generate a
# self-signed one (fine for personal/internal use; buy a real one for
# documents that need to be externally verifiable):
#   openssl genrsa -out private.key 2048
#   openssl req -new -x509 -key private.key -out certificate.crt -days 3650
#   openssl pkcs12 -export -out cert.p12 -inkey private.key -in certificate.crt -legacy
# Move the resulting cert.p12 to service_data/data/documenso/cert.p12
NEXT_PRIVATE_SIGNING_PASSPHRASE=

# SMTP — required for sending signing-request emails
NEXT_PRIVATE_SMTP_HOST=mailpit
NEXT_PRIVATE_SMTP_PORT=1025
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_FROM_ADDRESS=documenso@yourdomain.com

# Remaining Documenso env vars (image defaults — not previously set, no behavior change)
PORT=3000
NEXT_PUBLIC_UPLOAD_TRANSPORT=database
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=5
NEXT_PRIVATE_UPLOAD_REGION=us-east-1
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE=false
NEXT_PRIVATE_OIDC_PROVIDER_LABEL=OIDC
NEXT_PRIVATE_OIDC_SKIP_VERIFY=false
NEXT_PRIVATE_OIDC_PROMPT=login
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_UNSAFE_IGNORE_TLS=false
NEXT_PUBLIC_DISABLE_SIGNUP=true
NEXT_PUBLIC_DISABLE_EMAIL_PASSWORD_SIGNUP=false
NEXT_PUBLIC_DISABLE_GOOGLE_SIGNUP=false
NEXT_PUBLIC_DISABLE_MICROSOFT_SIGNUP=false
NEXT_PUBLIC_DISABLE_OIDC_SIGNUP=false
NEXT_PUBLIC_DISABLE_SIGNIN=false
NEXT_PUBLIC_FEATURE_BILLING_ENABLED=false
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_CSC_SIGNATURE_LEVEL=AES
NEXT_PRIVATE_USE_LEGACY_SIGNING_SUBFILTER=false
NEXT_PRIVATE_DOCUMENT_CONVERSION_TIMEOUT_MS=30000
NEXT_PRIVATE_JOBS_PROVIDER=local
NEXT_PRIVATE_REDIS_PREFIX=documenso
NEXT_PRIVATE_BULLMQ_CONCURRENCY=10
DOCUMENSO_DISABLE_TELEMETRY=false
