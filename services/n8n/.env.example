# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Postgres
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_strong_password

# Encrypts stored credentials — generate with: openssl rand -hex 32
# Set this before first start and never change/lose it, or every stored
# credential becomes unreadable.
N8N_ENCRYPTION_KEY=your_random_64_char_hex_secret

# No public self-registration — the first account becomes the instance owner,
# who then invites additional users from inside the app. No env var toggle
# applies here.

# Outgoing email — points at Mailpit (this stack's SMTP test-catcher,
# services/mailpit/) for testing; no real mail delivery.
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=mailpit
N8N_SMTP_PORT=1025
N8N_SMTP_SSL=false
N8N_SMTP_SENDER=n8n@example.com

# Phone-home behavior — off by default upstream. Disabled here because the
# owner-account email otherwise ends up on n8n GmbH's own outreach list,
# receiving real marketing/product emails from hello@info.n8n.io that never
# touch this stack's SMTP config (they're sent from n8n's own servers, not
# this container, so Mailpit can't catch them).
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false

# Remaining n8n env vars (image defaults — not previously set, no behavior change)
GENERIC_TIMEZONE=UTC
N8N_METRICS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# Database host/port. Default: this stack's shared server. Point at a managed
# database (AWS RDS, Azure Flexible Server, GCP Cloud SQL...) to move it out; homeserver.py
# then stops managing it here (docs/10-new-services.md "Managed-cloud parity").
DB_HOST=shared-postgres
DB_PORT=5432

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# n8n — Storage paths
DATA_ROOT=../../service_data/data/n8n

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret n8n-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
