# HomeBox — Storage paths
DATA_ROOT=../../service_data/data/homebox

# Logging
HBOX_LOG_LEVEL=info
HBOX_LOG_FORMAT=text

# Max attachment/photo upload size, in MB — bump this if phone photos of
# items routinely exceed the default.
HBOX_WEB_MAX_UPLOAD_SIZE=10

# Opt in/out of basic, anonymous usage analytics sent to the HomeBox team.
HBOX_OPTIONS_ALLOW_ANALYTICS=false

# Allow self-registration on the public https://homebox.<domain> page. This is
# a personal single-user inventory, so create your own account first, then
# flip this to false and restart the container to lock out further signups.
HBOX_OPTIONS_ALLOW_REGISTRATION=false

# Required. HMAC pepper for stored API key hashes — must be at least 32 bytes,
# the app refuses to start otherwise. Generated with: openssl rand -base64 48
# Keep this stable across restarts; rotating it invalidates every API key.
HBOX_AUTH_API_KEY_PEPPER=your_random_pepper_at_least_32_bytes

# Remaining HomeBox env vars (image defaults — not previously set, no behavior change)
HBOX_OPTIONS_AUTO_INCREMENT_ASSET_ID=true
HBOX_OPTIONS_ALLOW_LOCAL_LOGIN=true
HBOX_OPTIONS_GITHUB_RELEASE_CHECK=true
HBOX_OPTIONS_CURRENCY_CONFIG=
HBOX_OPTIONS_HOSTNAME=
# Points at Mailpit (this stack's SMTP test-catcher, services/mailpit/) for
# testing; no real mail delivery. No auth needed, no TLS (Mailpit doesn't
# support it) -- HBOX_MAILER_PORT must be set alongside HBOX_MAILER_HOST,
# see note this replaced: it's int-typed with no default, and Docker's
# env_file sets blank vars to an actual empty string (not "unset"), which
# crashes HomeBox's config parser on startup if host is set without it.
HBOX_MAILER_HOST=mailpit
HBOX_MAILER_PORT=1025
HBOX_MAILER_USERNAME=
HBOX_MAILER_PASSWORD=
HBOX_MAILER_FROM=homebox@example.com
HBOX_AUTH_RATE_LIMIT_ENABLED=true
HBOX_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
HBOX_AUTH_RATE_LIMIT_WINDOW=1m
HBOX_LABEL_MAKER_WIDTH=526
HBOX_LABEL_MAKER_HEIGHT=200
HBOX_LABEL_MAKER_FONT_SIZE=32.0
HBOX_LABEL_MAKER_DYNAMIC_LENGTH=true
HBOX_LABEL_MAKER_PRINT_COMMAND=
HBOX_THUMBNAIL_ENABLED=true
HBOX_THUMBNAIL_WIDTH=500
HBOX_THUMBNAIL_HEIGHT=500
HBOX_BARCODE_TOKEN_BARCODESPIDER=
HBOX_BARCODE_OPEN_FOOD_FACTS_CONTACT=
HBOX_OIDC_ENABLED=false
