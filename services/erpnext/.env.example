# ERPNext — Storage paths
DATA_ROOT=../../service_data/data/erpnext

# Image tag — pin explicitly, check https://hub.docker.com/r/frappe/erpnext/tags for updates
ERPNEXT_VERSION=v16.36.0

# MariaDB root password (also used for the one-time `bench new-site`
# command — see docs/services/erpnext.md)
DB_PASSWORD=your_strong_password

# Gunicorn tuning (image defaults shown — safe to leave as-is)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
