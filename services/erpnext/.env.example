# ERPNext — Storage paths
DATA_ROOT=../../service_data/data/erpnext

# Image tag — pin explicitly, check https://hub.docker.com/r/frappe/erpnext/tags for updates
ERPNEXT_VERSION=v16.37.0

# MariaDB root password (also used for the one-time `bench new-site`
# command — see docs/services/erpnext.md)
DB_PASSWORD=your_strong_password

# Gunicorn tuning (image defaults shown — safe to leave as-is)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# Administrator password for the site erpnext-create-site makes on a fresh
# install (login: Administrator). Only read when the site doesn't exist yet;
# change it later in the UI or with `bench set-admin-password`.
ERPNEXT_ADMIN_PASSWORD=your_strong_password

# Backing-service endpoints (database, cache, queue, storage). Defaults are this
# stack's own containers; point them at managed services (AWS/Azure/GCP) to move
# a tier out without touching compose. See docs/10-new-services.md "Managed-cloud parity".
DB_HOST=erpnext-db
DB_PORT=3306
CACHE_HOST=erpnext-redis-cache
CACHE_PORT=6379
QUEUE_HOST=erpnext-redis-queue
QUEUE_PORT=6379
