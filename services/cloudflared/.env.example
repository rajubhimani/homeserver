# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Cloudflare Tunnel token
# Get this from: https://one.dash.cloudflare.com → Networks → Tunnels → Create tunnel
# Select "Docker" as the connector type — the dashboard shows the exact token.
# One token per tunnel. Each tunnel can serve multiple public hostnames.
TUNNEL_TOKEN=your_tunnel_token_here

# Remaining cloudflared env vars (image defaults — not previously set, no behavior change)
TUNNEL_LOGLEVEL=info
TUNNEL_RETRIES=5
TUNNEL_GRACE_PERIOD=30s
TUNNEL_EDGE_IP_VERSION=4

# cloudflared-watchdog: restarts cloudflared when the tunnel itself is stale (the edge
# has dropped its connections while the container still looks healthy).
# Best probe: ask Cloudflare for the tunnel's status. Create an API token (dash.cloudflare.com
# -> My Profile -> API Tokens -> Create Custom Token, permission Account / Cloudflare Tunnel /
# Read) and set it here; the account and tunnel IDs are read from TUNNEL_TOKEN.
# CLOUDFLARE_API_TOKEN=
# Without a token, or when the API doesn't answer, it requests WATCHDOG_HOST and treats
# Cloudflare's 530 as stale. That must be a hostname routed through the tunnel: the apex
# and docs.<domain> are answered by Cloudflare itself and stay up while the tunnel is dead.
# WATCHDOG_HOST=immich.yourdomain.com
# Other knobs (defaults: 60s interval, 3 failures before restarting where a good answer
# cancels one, 120s cooldown after a restart before checks resume).
# WATCHDOG_CHECK_INTERVAL=60
# WATCHDOG_FAIL_THRESHOLD=3
# WATCHDOG_RESTART_COOLDOWN=120

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret cloudflared-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
