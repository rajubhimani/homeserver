# ════════════════════════════════════════════════════════════
# Common: Docker Compose and Kubernetes
# ════════════════════════════════════════════════════════════
# Postgres
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=your_strong_password

# Nextcloud admin account
# IMPORTANT: password must not contain $ (dollar sign) — Docker Compose will
# treat $VAR patterns as variable references and mangle the value. Use hex or
# alphanumeric passwords only (e.g. openssl rand -hex 20)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=your_strong_password_no_dollar_signs

# How often nextcloud-cron runs Nextcloud's background jobs (cron.php), in
# seconds. 300 (5 minutes) is what Nextcloud documents.
CRON_INTERVAL_SECONDS=300

# Remaining Nextcloud env vars (image defaults — not previously set, no behavior change)
NEXTCLOUD_DATA_DIR=/var/www/html/data
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=512M
APACHE_BODY_LIMIT=1073741824
NEXTCLOUD_UPDATE=0

# Backing-service endpoints (database, cache, queue, storage). Defaults are this
# stack's own containers; point them at managed services (AWS/Azure/GCP) to move
# a tier out without touching compose. See docs/10-new-services.md "Managed-cloud parity".
DB_HOST=nextcloud-db
DB_PORT=5432
CACHE_HOST=nextcloud-redis
CACHE_PORT=6379

# ════════════════════════════════════════════════════════════
# Docker Compose only (Kubernetes ignores these, or uses the values below)
# ════════════════════════════════════════════════════════════
# Nextcloud — Storage paths
DATA_ROOT=../../service_data/data/nextcloud

# ════════════════════════════════════════════════════════════
# Kubernetes
# ════════════════════════════════════════════════════════════
# Nothing to change for Kubernetes: cluster.py secrets loads this whole file
# as Secret nextcloud-env, and kubernetes/generate.py sets what differs:
#   (nothing differs for this service)
# DATA_ROOT is replaced by the service's volumes (storage classes fast/bulk).
