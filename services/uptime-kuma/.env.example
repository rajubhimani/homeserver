# Uptime Kuma — Storage paths
DATA_ROOT=../../service_data/data/uptime-kuma

# MariaDB
MYSQL_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=uptime_kuma
MYSQL_USER=uptime_kuma
MYSQL_PASSWORD=your_strong_password

# Timezone used for displayed/logged timestamps (heartbeat times, status page
# clocks) — image defaults to UTC if unset.
TZ=Asia/Kolkata

# Remaining Uptime Kuma env vars (image defaults — not previously set, no
# behavior change). Full list: https://github.com/louislam/uptime-kuma/wiki/Environment-Variables
# UPTIME_KUMA_PORT=3001
# UPTIME_KUMA_HOST=::
# Allow embedding the dashboard/status pages in an <iframe> from another
# origin (default protects against clickjacking — leave false unless you
# specifically need to embed a status page elsewhere).
# UPTIME_KUMA_DISABLE_FRAME_SAMEORIGIN=false
# UPTIME_KUMA_WS_ORIGIN_CHECK=cors-like
# Allow any executable path as the "Chromium" binary for browser-engine
# monitors (default 0 restricts to known Chrome/Chromium paths).
# UPTIME_KUMA_ALLOW_ALL_CHROME_EXEC=0
# Extra CA cert bundle for monitors hitting internal HTTPS endpoints signed
# by a private/self-signed CA.
# NODE_EXTRA_CA_CERTS=
# HTTP(S)/SOCKS proxy to route outgoing notification requests through.
# NOTIFICATION_PROXY=
