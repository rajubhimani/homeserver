# Zulip — Storage paths: none under service_data/ — everything Zulip needs
# (Postgres, RabbitMQ, Redis, its own /data) lives in named volumes; see
# docs/services/zulip.md for why.

# Image tags — pin explicitly. Check for updates:
#   https://github.com/zulip/docker-zulip/pkgs/container/zulip-server
ZULIP_VERSION=12.2-0

# Required by Zulip itself
ZULIP_ADMIN_EMAIL=admin@example.com

# Off by default upstream (anyone who can reach this server could otherwise
# create an org, not just you) — defaults to enabled here since this is a
# single-user homelab playground. Adds a "Create new organization" link to
# the homepage and makes plain /new/ work directly, no CLI-generated
# single-use link needed. Set to False to go back to the safer default
# (docker exec zulip su zulip -c "/home/zulip/deployments/current/manage.py
# generate_realm_creation_link" for each new org instead).
ZULIP_OPEN_REALM_CREATION=True

# Docker Compose secrets sourced from these env vars (not files) — see
# compose.yml's top-level `secrets:` block. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ZULIP__POSTGRES_PASSWORD=your_strong_password
ZULIP__MEMCACHED_PASSWORD=your_strong_password
ZULIP__RABBITMQ_PASSWORD=your_strong_password
ZULIP__REDIS_PASSWORD=your_strong_password
ZULIP__SECRET_KEY=your_secret_key
# Only needed if you configure real outgoing email (SETTING_EMAIL_HOST
# points at the shared Mailpit catcher by default, no auth needed) — leave
# as a placeholder unless you point SETTING_EMAIL_HOST at a real relay.
ZULIP__EMAIL_PASSWORD=unused_placeholder

# Remaining Zulip env vars (image defaults — not previously set, no
# behavior change). Verified live via `manage.py shell` against this
# stack's own running instance, not just docs.
SETTING_MAX_FILE_UPLOAD_SIZE=100
SETTING_RATE_LIMITING=True
SETTING_PASSWORD_MIN_LENGTH=8
SETTING_SESSION_COOKIE_AGE=1209600
