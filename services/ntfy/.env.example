# ntfy — Storage paths
DATA_ROOT=../../service_data/data/ntfy

# Personal push-notification server — default deny-all (private): nobody can
# read/write any topic without logging in. Create your own user after first
# start with:
#   docker exec -it ntfy ntfy user add --role=admin youruser
# Set to "read-write" instead if you'd rather run it open (no accounts, no
# private topics) the way the public ntfy.sh instance works.
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# Remaining ntfy env vars (image defaults — not previously set, no behavior change)
NTFY_CACHE_DURATION=12h
NTFY_ATTACHMENT_TOTAL_SIZE_LIMIT=5G
NTFY_ATTACHMENT_FILE_SIZE_LIMIT=15M
NTFY_ATTACHMENT_EXPIRY_DURATION=3h
NTFY_ENABLE_LOGIN=false
NTFY_ENABLE_SIGNUP=false
NTFY_ENABLE_RESERVATIONS=false
NTFY_SMTP_SENDER_ADDR=
NTFY_SMTP_SERVER_LISTEN=
NTFY_UPSTREAM_BASE_URL=
NTFY_WEB_PUSH_FILE=
NTFY_PROXY_FORWARDED_HEADER=X-Forwarded-For
NTFY_PROXY_TRUSTED_HOSTS=
NTFY_VISITOR_REQUEST_LIMIT_BURST=60
NTFY_VISITOR_REQUEST_LIMIT_REPLENISH=5s
NTFY_VISITOR_MESSAGE_DAILY_LIMIT=
NTFY_VISITOR_SUBSCRIPTION_LIMIT=30
NTFY_VISITOR_ATTACHMENT_TOTAL_SIZE_LIMIT=100M
NTFY_VISITOR_ATTACHMENT_DAILY_BANDWIDTH_LIMIT=500M
NTFY_VISITOR_TOPIC_CREATION_LIMIT_BURST=100
NTFY_VISITOR_TOPIC_CREATION_LIMIT_REPLENISH=1m
NTFY_GLOBAL_TOPIC_LIMIT=15000
NTFY_MESSAGE_SIZE_LIMIT=4096
NTFY_WEB_ROOT=nano
NTFY_BAN_FILE=
NTFY_BAN_WINDOW=10m
NTFY_BAN_THRESHOLD=100
NTFY_LOG_LEVEL=info
