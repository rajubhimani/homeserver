# Standalone test instance: Jellyfin 10.11.11 running on the JPVenson/Jellyfin.Pgsql
# fork (Postgres backend instead of SQLite) to test whether Postgres avoids the
# OptimisticLockBehavior write-stall seen on the real jellyfin instance.
# See docs/services/jellyfin-pgsql-test.md for full details/history.
#
# Completely separate from the real jellyfin/ service: own container names,
# own data dir, own Postgres DB. Media is mounted read-only from the real
# library so nothing here can modify it. SERVICES_MANUAL only — never started
# by `up min/core/all`, only via `up jellyfin-pgsql-test` explicitly.
# Public URL: https://jellyfin-test.${DOMAIN}

DATA_ROOT=../service_data/data/jellyfin-pgsql-test
MEDIA_ROOT=../service_data/media/jellyfin

POSTGRES_DB=jellyfin
POSTGRES_USER=jellyfin
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=changeme
