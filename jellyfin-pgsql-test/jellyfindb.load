LOAD DATABASE
     FROM sqlite:///data/jellyfin.db
     INTO postgresql://jellyfin:bbcf8d39ba53f46ee57d90182223d43f@jellyfin-pgsql-test-db:5432/jellyfin

 WITH include no drop, truncate, create no tables, create no indexes, reset sequences, quote identifiers

  SET work_mem to '256MB', maintenance_work_mem to '512 MB'

 CAST type datetime to timestamptz drop default drop not null using zero-dates-to-null,
      type date drop not null drop default using zero-dates-to-null

 ;
