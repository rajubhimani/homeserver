# Immich — Storage paths
# Deliberately kept OUTSIDE service_data/data/immich/ (a sibling under
# service_data/uploads/ instead) so `homeserver.py`'s backup_service() — which
# tars the whole DATA_ROOT dir — never sweeps the entire photo/video library
# into a snapshot. See docs/services/immich.md for the incident that prompted
# this convention.
UPLOAD_LOCATION=../service_data/uploads/immich
# Postgres data lives in the named Docker volume `immich-postgres` (see compose.yml) —
# not a bind mount, to avoid cross-platform ownership issues. Back up/restore it with
# `uv run homeserver.py <env> backup immich` / `restore immich`.

# Media library paths (read-only mounts from your media drive)
# Uncomment and set to your actual paths when you have existing media to import
# PHOTOS_LOCATION=/mnt/seagate/photos
# VIDEOS_LOCATION=/mnt/seagate/videos

# Immich secret (generate with: openssl rand -hex 32)
IMMICH_SECRET=your_hex_secret_here

# Postgres
DB_USERNAME=immich
DB_PASSWORD=your_strong_password
DB_DATABASE_NAME=immich

# DB_URL must use the service name (immich-database), not localhost
DB_URL=postgresql://immich:your_strong_password@immich-database:5432/immich

# Offline remover API key (create in Immich → Account → API Keys)
IMMICH_OFFLINE_API_KEY=your_api_key_here

# Windows Docker Desktop bind mounts have been observed failing Immich's own
# startup mount-integrity check on upload/ (a write succeeds, the very next
# read of the same file returns ENOENT) — see compose.yml for details. Set
# to true on Windows; leave false on Linux/Mac where this hasn't been observed.
IMMICH_IGNORE_MOUNT_CHECK_ERRORS=false

# Remaining Immich env vars (defaults — not previously set, no behavior change)
IMMICH_LOG_LEVEL=log
DB_SKIP_MIGRATIONS=false
DB_VECTOR_EXTENSION=vectorchord
TZ=Etc/UTC
